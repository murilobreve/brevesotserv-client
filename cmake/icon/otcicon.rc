#include <winver.h>

IDI_ICON1    ICON  DISCARDABLE    "otcicon.ico"

// file details Windows shows in Properties > Details; an executable without
// them looks more suspicious to antivirus heuristics
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Baiak Breves"
            VALUE "FileDescription", "Baiak Breves - client do jogo"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "otclient"
            VALUE "LegalCopyright", "Baiak Breves. Baseado no OTClient (MIT)."
            VALUE "OriginalFilename", "Baiak Breves.exe"
            VALUE "ProductName", "Baiak Breves"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END

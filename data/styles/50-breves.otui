// Building blocks for the Baiak Breves windows (heal bot, hunt board, hunt
// tasks, rarity market). They copy what the client's own Tibia windows do:
// Highscores (framed filter panel, black-bordered table, zebra rows),
// Options (grey category buttons in cipsoftFont) and Prey (dark value boxes).

// framed sub panel with its title in the top strip, like "Highscores Filter"
BrevesSection < Panel
  image-source: /images/ui/window_new
  image-border: 4
  image-border-top: 17
  padding: 22 6 6 6
  text-align: top
  text-offset: 0 3
  color: #bfbfbf
  font: verdana-11px-monochrome

// tab or category button, like the Options categories
BrevesTab < UIButton
  size: 118 20
  image-source: /images/ui/button-grey-up
  image-border: 5
  font: cipsoftFont
  color: #dfdfdf
  text-offset: 0 1
  $hover !checked:
    color: #ffffff
  $pressed:
    image-source: /images/ui/button-grey-down
  $checked:
    image-source: /images/ui/button-grey-down
    color: #ffffff
    text-offset: 1 2

// table body: black border over the window texture, rows stack inside
BrevesList < UIScrollArea
  border-width: 1
  border-color: #000000
  background-color: #00000026
  padding: 1
  layout:
    type: verticalBox

// column header strip on top of a BrevesList
BrevesHeader < UIWidget
  height: 20
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  font: verdana-11px-antialised
  color: #dfdfdf88
  text-align: left
  text-offset: 6 0

// zebra rows: odd rows keep the texture, even rows get the light tint
BrevesRow < UIWidget
  focusable: true
  background-color: #00000012
  $hover !focus:
    background-color: #ffffff1a
  $focus:
    background-color: #ffffff30

BrevesRowEven < BrevesRow
  background-color: #ffffff12

// dark box with a value and an icon, like the gold box in Prey
BrevesValueBox < UIWidget
  height: 20
  background-color: #00000066
  border-width: 1
  border-color: #000000
  font: verdana-11px-antialised
  color: #dfdfdf
  text-align: right
  text-offset: -20 0

  UIWidget
    id: icon
    size: 12 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    phantom: true

// cell for a creature or item, like the Prey creature grid
BrevesCell < UIWidget
  background-color: #00000040
  border-width: 1
  border-color: #000000

BrevesNote < Label
  font: verdana-11px-monochrome
  color: #909090
  text-wrap: true
  text-auto-resize: true

BrevesLabel < Label
  font: verdana-11px-monochrome
  color: #bfbfbf

// Quests: the list of the quests (those of the Mythos, then those of the
// teleport room) and the chosen one with its reward and its monsters. The
// same look as the Bosses window (game_bosses/bosses.otui): dark boxes, a
// framed portrait per row, the chosen one on a pedestal, tiles and cells.

// a choice over the list: one of three, the one in use in gold
QuestChip < UIButton
  size: 80 24
  font: verdana-11px-antialised
  color: #b4afc3
  background-color: #171221
  border-width: 1
  border-color: #3e2d5e
  change-cursor-image: true
  cursor: pointer
  $hover !checked:
    border-color: #8a76b0
    color: #f3f0fa
  $checked:
    background-color: #d9a43a38
    border-color: #d9b45a
    color: #ffe7b0

QuestBox < UIWidget
  background-color: #141117
  border-width: 1
  border-color: #2e2833

QuestDim < Label
  font: verdana-11px-antialised
  color: #8f877c

QuestPill < Label
  height: 16
  text-auto-resize: true
  text-align: center
  padding: 0 6
  font: verdana-11px-antialised
  border-width: 1
  phantom: true

// a quest of the list: its strongest monster (or its reward, for a quest of
// the teleport room), name, level and what is not the normal case at right
QuestRow < UIWidget
  height: 48
  background-color: #141117
  border-width: 1
  border-color: #221e26
  focusable: true

  $hover !focus:
    background-color: #1d1922

  $focus:
    background-color: #1e1a24
    border-color: #6b5631

  UIWidget
    id: frame
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    size: 40 40
    background-color: #17131a
    border-width: 1
    border-color: #2a2430
    phantom: true

    UICreature
      id: creature
      anchors.centerIn: parent
      size: 38 38
      creature-size: 38
      phantom: true

    UIItem
      id: item
      anchors.centerIn: parent
      size: 32 32
      virtual: true
      phantom: true
      visible: false

  Label
    id: status
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    height: 14
    text-auto-resize: true
    text-align: right
    font: verdana-11px-antialised
    phantom: true

  Label
    id: name
    anchors.left: frame.right
    anchors.right: status.left
    anchors.top: parent.top
    margin-left: 8
    margin-right: 6
    margin-top: 8
    height: 14
    font: Verdana Bold-11px
    color: #ece6dc
    phantom: true

  Label
    id: info
    anchors.left: name.left
    anchors.right: status.left
    anchors.top: name.bottom
    margin-top: 3
    margin-right: 6
    height: 14
    font: verdana-11px-antialised
    color: #a59d92
    phantom: true

// the title of a group of the list, with how many it has
QuestSection < UIWidget
  height: 22
  focusable: false
  phantom: true

  Label
    id: title
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 2
    margin-bottom: 3
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #e8c77a

  Label
    id: count
    anchors.right: parent.right
    anchors.verticalCenter: title.verticalCenter
    margin-right: 2
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #8f877c

  UIWidget
    anchors.left: title.right
    anchors.right: count.left
    anchors.verticalCenter: title.verticalCenter
    margin-left: 8
    margin-right: 8
    height: 1
    background-color: #2e2833

// a number of the quest: what on top, how much under it
QuestTile < UIWidget
  height: 40
  background-color: #17141a
  border-width: 1
  border-color: #2a2430

  Label
    id: key
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 5
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #a59d92
    phantom: true

  Label
    id: value
    anchors.left: key.left
    anchors.top: key.bottom
    margin-top: 2
    text-auto-resize: true
    font: Verdana Bold-11px
    color: #ece6dc
    phantom: true

// the title of a part of the chosen quest, with a word at right
QuestHead < UIWidget
  height: 16

  Label
    id: title
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #a59d92
    phantom: true

  Label
    id: extra
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #8f877c
    phantom: true

// a reward or a monster: its picture in a frame, its name and one fact
QuestCell < UIWidget
  height: 44
  background-color: #17141a
  border-width: 1
  border-color: #2a2430

  UIWidget
    id: frame
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 36 36
    background-color: #17131a
    border-width: 1
    border-color: #2a2430
    phantom: true

    UIItem
      id: item
      anchors.centerIn: parent
      size: 32 32
      virtual: true
      phantom: true

    UICreature
      id: creature
      anchors.centerIn: parent
      size: 34 34
      creature-size: 34
      phantom: true
      visible: false

    // what is not an item (Rarity XP)
    UIWidget
      id: icon
      anchors.centerIn: parent
      size: 18 18
      phantom: true
      visible: false

  Label
    id: name
    anchors.left: frame.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    margin-right: 4
    margin-top: 7
    height: 14
    font: verdana-11px-antialised
    color: #ece6dc
    phantom: true

  Label
    id: sub
    anchors.left: name.left
    anchors.right: parent.right
    anchors.top: name.bottom
    margin-top: 2
    margin-right: 4
    height: 14
    font: verdana-11px-antialised
    color: #a59d92
    phantom: true

// two cells a line, as the loot of a boss
QuestGrid < UIWidget
  height: 44
  layout:
    type: grid
    cell-size: 163 44
    cell-spacing: 4
    num-columns: 2

// the one action of the window: go to the quest (the gold button of the
// Hunts and Bosses windows)
QuestGoButton < UIButton
  height: 36
  font: Verdana Bold-11px
  color: #f3d38a
  background-color: #2a2219
  border-width: 1
  border-color: #8a6d36
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    background-color: #3a2e1f
    border-color: #b08a42
    color: #ffe9b5

  $pressed !disabled:
    background-color: #1f1912

  $disabled:
    color: #7d7466
    background-color: #1b1816
    border-color: #3a3330
    change-cursor-image: false

MythosWindow
  id: questsWindow
  // as wide as the Bosses window: the cells of the chosen quest are 330 px
  size: 778 640
  @onEscape: modules.game_quests.hide()

  UIButton
    id: closeX
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -34
    margin-right: -8
    size: 22 22
    text: X
    font: Verdana Bold-11px
    color: #d6cfc2
    background-color: #2a2219
    border-width: 1
    border-color: #6b5631
    change-cursor-image: true
    cursor: pointer
    @onClick: modules.game_quests.hide()

    $hover:
      color: #ffffff
      background-color: #3d2f20
      border-color: #a8884a

  MythosTextEdit
    id: search
    anchors.top: parent.top
    anchors.left: parent.left
    width: 250
    !placeholder: tr('Search quest, monster or item')
    placeholder-color: #75688f
    @onTextChange: modules.game_quests.refreshList()

  Label
    id: summary
    anchors.verticalCenter: search.verticalCenter
    anchors.right: parent.right
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #9fd99a

  // what the server answers to a teleport (quests.lua: showMessage)
  Label
    id: message
    anchors.top: search.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 15
    font: verdana-11px-antialised

  UIWidget
    id: middle
    anchors.top: message.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 3
    width: 386

    QuestChip
      id: openTab
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('To do')
      @onClick: modules.game_quests.setFilter('open')

    QuestChip
      id: allTab
      anchors.top: parent.top
      anchors.left: prev.right
      margin-left: 4
      !text: tr('All quests')
      @onClick: modules.game_quests.setFilter('all')

    QuestChip
      id: doneTab
      anchors.top: parent.top
      anchors.left: prev.right
      margin-left: 4
      !text: tr('Completed')
      @onClick: modules.game_quests.setFilter('done')

    ScrollablePanel
      id: list
      anchors.top: openTab.bottom
      anchors.left: parent.left
      anchors.right: listScroll.left
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-right: 3
      vertical-scrollbar: listScroll
      layout:
        type: verticalBox
        spacing: 4

    // (anchored to the chips, not to the list: the list is anchored to it)
    MythosScrollBar
      id: listScroll
      anchors.top: openTab.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      step: 52
      pixels-scroll: true

    // no quest for the search or the choice (quests.lua: refreshList)
    QuestDim
      id: empty
      anchors.centerIn: list
      text-auto-resize: true
      visible: false

  QuestBox
    id: detail
    anchors.top: middle.top
    anchors.left: middle.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 10
    padding: 10

    UIWidget
      id: pedestal
      anchors.top: parent.top
      anchors.left: parent.left
      size: 96 96
      phantom: true

      UIWidget
        id: aura
        anchors.fill: parent
        image-source: /game_bosses/images/aura
        phantom: true

      UIWidget
        id: disc
        anchors.centerIn: parent
        size: 80 80
        image-source: /game_bosses/images/disc
        image-color: #151118
        phantom: true

      UICreature
        id: creature
        anchors.centerIn: parent
        size: 72 72
        creature-size: 72
        phantom: true

      // a quest of the teleport room: its reward, twice the size
      UIItem
        id: item
        anchors.centerIn: parent
        size: 64 64
        virtual: true
        phantom: true
        visible: false

    QuestPill
      id: status
      anchors.top: pedestal.top
      anchors.left: pedestal.right
      margin-left: 10
      margin-top: 6

    // a challenge quest says so beside its state
    QuestPill
      id: kind
      anchors.verticalCenter: status.verticalCenter
      anchors.left: status.right
      margin-left: 4
      color: #e8c77a
      background-color: #2a2219
      border-color: #5c4a2c

    Label
      id: name
      anchors.top: status.bottom
      anchors.left: status.left
      anchors.right: parent.right
      margin-top: 5
      height: 22
      ttf-font: cinzel-bold
      ttf-font-size: 16
      color: #ece6dc

    Label
      id: sub
      anchors.top: name.bottom
      anchors.left: status.left
      anchors.right: parent.right
      margin-top: 2
      height: 28
      text-wrap: true
      font: verdana-11px-antialised
      color: #a59d92

    UIWidget
      id: stats
      anchors.top: pedestal.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 40
      layout:
        type: grid
        cell-size: 106 40
        cell-spacing: 5
        num-columns: 3

    UIWidget
      id: line
      anchors.top: stats.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 1
      background-color: #2e2833

    // the reward and the monsters; it scrolls when a quest has many
    // (quests.lua: renderCard)
    ScrollablePanel
      id: body
      anchors.top: line.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: go.top
      margin-top: 8
      margin-bottom: 8
      vertical-scrollbar: bodyScroll
      layout:
        type: verticalBox

      QuestHead
        id: pickHead

      QuestGrid
        id: picks
        margin-top: 4

      QuestHead
        id: prizeHead
        margin-top: 10

      QuestGrid
        id: prize
        margin-top: 4

      // the odds that a reward comes out a rarity item, by grade (gamelib's
      // UIRarityBar)
      QuestHead
        id: rarityHead
        margin-top: 10

      UIRarityBar
        id: rarityBar
        margin-top: 4
        height: 8
        padding: 1
        background-color: #241f28
        border-width: 1
        border-color: #2a2430

      QuestHead
        id: monstersHead
        margin-top: 10

      QuestGrid
        id: monsters
        margin-top: 4

      // a quest of the teleport room whose reward the scripts do not tell
      QuestDim
        id: nothing
        height: 30
        text-wrap: true

    // in the box's own padding, and only when the quest has more than fits
    MythosScrollBar
      id: bodyScroll
      anchors.top: body.top
      anchors.bottom: body.bottom
      anchors.right: parent.right
      margin-right: -10
      width: 8
      step: 48
      pixels-scroll: true

    QuestGoButton
      id: go
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr('Teleport to the quest')
      @onClick: modules.game_quests.goSelected()

    // a teleport: the portal of the Teleports row of the bar
    UIWidget
      id: goIcon
      anchors.left: go.left
      anchors.verticalCenter: go.verticalCenter
      margin-left: 12
      size: 16 16
      image-source: /game_brevespanel/images/teleport
      phantom: true

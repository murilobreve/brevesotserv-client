TeleportLabel < UIWidget
  height: 18
  background-color: #0e0a18e6
  border-width: 1
  border-color: #6e58c0
  phantom: true
  focusable: false
  opacity: 0

  UIWidget
    id: gem
    size: 10 10
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    phantom: true

  UILabel
    id: name
    font: verdana-11px-rounded
    text-align: center
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 18
    margin-right: 4
    phantom: true

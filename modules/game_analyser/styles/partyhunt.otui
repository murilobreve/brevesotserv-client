PartyLootTab < Button
  height: 17
  font: verdana-11px-monochrome
  text-offset: 0 1
  color: #9d9d9d
  $on:
    color: #ffffff

PartyLootSmallButton < Button
  height: 17
  font: verdana-11px-monochrome
  text-offset: 0 1

PartyLootText < Label
  font: verdana-11px-monochrome
  color: #a8a8a8
  text-auto-resize: true

PartyLootWrap < Label
  font: verdana-11px-monochrome
  color: #a8a8a8
  text-wrap: true
  text-auto-resize: true
  margin-top: 2

PartyLootRow < UIWidget
  height: 36
  margin-top: 2
  background-color: #ffffff0a
  Item
    id: item
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    virtual: true
    phantom: true
  Label
    id: name
    anchors.top: parent.top
    anchors.left: item.right
    anchors.right: parent.right
    margin-left: 4
    margin-top: 3
    margin-right: 2
    font: Verdana Bold-11px
    color: #c0c0c0
    phantom: true
  Label
    id: value
    anchors.bottom: parent.bottom
    anchors.left: item.right
    anchors.right: claim.left
    margin-left: 4
    margin-bottom: 3
    margin-right: 2
    font: verdana-11px-monochrome
    color: #e8d27a
    phantom: true
  PartyLootSmallButton
    id: claim
    width: 40
    height: 15
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 2
    margin-bottom: 2

PartyLootSum < UIWidget
  height: 14
  Label
    id: label
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-monochrome
    color: #9d9d9d
    text-auto-resize: true
    phantom: true
  Label
    id: amount
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-monochrome
    color: #c0c0c0
    text-auto-resize: true
    phantom: true

PartyLootPerson < UIWidget
  height: 29
  margin-top: 3
  UIWidget
    id: dot
    size: 7 7
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 4
    background-color: #6a6a6a
    phantom: true
  Label
    id: name
    anchors.left: dot.right
    anchors.right: amount.left
    anchors.top: parent.top
    margin-left: 4
    margin-right: 2
    font: Verdana Bold-11px
    color: #c0c0c0
    phantom: true
  Label
    id: amount
    anchors.right: parent.right
    anchors.top: parent.top
    font: Verdana Bold-11px
    text-auto-resize: true
    phantom: true
  Label
    id: spent
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 11
    font: verdana-11px-monochrome
    color: #c88a5a
    text-auto-resize: true
    phantom: true
  Label
    id: looted
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    font: verdana-11px-monochrome
    color: #8a8a8a
    text-auto-resize: true
    phantom: true

PartyLootMember < UIWidget
  height: 15
  margin-top: 1
  UIWidget
    id: dot
    size: 7 7
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    background-color: #6a6a6a
    phantom: true
  Label
    id: name
    anchors.left: dot.right
    anchors.right: amount.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    margin-right: 2
    font: verdana-11px-monochrome
    color: #c0c0c0
    phantom: true
  Label
    id: amount
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: Verdana Bold-11px
    text-auto-resize: true
    phantom: true

LeaderInfo < UIWidget
  size: 151 63
  margin-top: 5
  UIWidget
    id: leaderPt
    size: 11 11
    image-source: /images/game/shields/shields
    image-clip: 0 0 11 11
    anchors.top: parent.top
    anchors.left: parent.left
  Label
    id: name
    !text: tr('Name')
    anchors.top: prev.top
    anchors.left: prev.right
    text-auto-resize: true
    color: #ffda34
    font: Verdana Bold-11px
    margin-left: 3
    margin-top: -3
  UIWidget
    id: balanceIcon
    size: 11 11
    image-auto-resize: true
    image-source: /images/icons/icon-balance
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 5
    margin-left: 7
    !tooltip: tr('Balance')
  UIWidget
    id: damageIcon
    size: 11 11
    image-auto-resize: true
    image-source: /images/icons/icon-damage
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 7
    !tooltip: tr('Damage')
  UIWidget
    id: healingIcon
    size: 11 11
    image-auto-resize: true
    image-source: /images/icons/icon-healing
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 7
    !tooltip: tr('Healing')
  UIWidget
    id: gold
    size: 9 9
    image-auto-resize: true
    image-source: /game_cyclopedia/images/icon_gold
    anchors.top: balanceIcon.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
  UIWidget
    id: balance
    !text: tr('0')
    anchors.top: balanceIcon.top
    anchors.right: prev.left
    margin-top: -2
    margin-right: 4
    text-auto-resize: true
    color: #44ad25
    font: Verdana Bold-11px
    tooltip-font: Verdana Bold-11px-wheel
    tooltip-delayed: true
  Label
    id: damage
    !text: tr('0')
    anchors.top: damageIcon.top
    anchors.right: parent.right
    margin-top: -2
    margin-right: 2
    text-auto-resize: true
    color: #c0c0c0
    font: Verdana Bold-11px
  Label
    id: healing
    !text: tr('0')
    anchors.top: healingIcon.top
    anchors.right: parent.right
    margin-top: -2
    margin-right: 2
    text-auto-resize: true
    color: #c0c0c0
    font: Verdana Bold-11px

Info < UIWidget
  size: 151 63
  margin-top: 2
  Label
    id: name
    !text: tr('Name')
    anchors.top: parent.top
    anchors.left: parent.left
    text-auto-resize: true
    color: #c0c0c0
    font: Verdana Bold-11px
  UIWidget
    id: balanceIcon
    size: 11 11
    image-auto-resize: true
    image-source: /images/icons/icon-balance
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 5
    margin-left: 7
    !tooltip: tr('Balance')
  UIWidget
    id: damageIcon
    size: 11 11
    image-auto-resize: true
    image-source: /images/icons/icon-damage
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 7
    !tooltip: tr('Damage')
  UIWidget
    id: healingIcon
    size: 11 11
    image-auto-resize: true
    image-source: /images/icons/icon-healing
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 7
    !tooltip: tr('Healing')
  UIWidget
    id: gold
    size: 9 9
    image-auto-resize: true
    image-source: /game_cyclopedia/images/icon_gold
    anchors.top: balanceIcon.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
  UIWidget
    id: balance
    !text: tr('0')
    anchors.top: balanceIcon.top
    anchors.right: prev.left
    margin-top: -2
    margin-right: 4
    text-auto-resize: true
    color: #44ad25
    font: Verdana Bold-11px
    tooltip-font: Verdana Bold-11px-wheel
    tooltip-delayed: true
  Label
    id: damage
    !text: tr('0')
    anchors.top: damageIcon.top
    anchors.right: parent.right
    margin-top: -2
    margin-right: 2
    text-auto-resize: true
    color: #c0c0c0
    font: Verdana Bold-11px
  Label
    id: healing
    !text: tr('0')
    anchors.top: healingIcon.top
    anchors.right: parent.right
    margin-top: -2
    margin-right: 2
    text-auto-resize: true
    color: #c0c0c0
    font: Verdana Bold-11px

MiniWindow
  id: phAnalyserMiniWindow
  &type: 'partyHuntAnalyser'
  !text: tr('Party Hunt')
  height: 225
  &save: true
  &autoOpen: true
  @onExtra: modules.game_analyser.onPartyHuntExtra(g_window.getMousePosition())

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/icons/icon-partyhunt-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    color: #9d9d9dff
    !text: tr('Party Hunt')

  Panel
    id: tabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 18 18 0 5
    height: 16

    PartyLootTab
      id: summaryTab
      !text: tr('Resumo')
      anchors.top: parent.top
      anchors.left: parent.left
      width: 60
      @onClick: modules.game_analyser.PartyLoot.showTab('summary')

    PartyLootTab
      id: lootTab
      !text: tr('Loot')
      anchors.top: parent.top
      anchors.left: prev.right
      margin-left: 2
      width: 60
      @onClick: modules.game_analyser.PartyLoot.showTab('loot')

  ScrollablePanel
    id: contentsPanel
    anchors.fill: parent
    margin: 38 18 5 5
    vertical-scrollbar: miniwindowScrollBar


    Label
      id: sessionLabel
      !text: tr('Session:')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px

    Label
      id: session
      !text: tr('00:00h')
      anchors.top: parent.top
      anchors.right: parent.right
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px

    Label
      id: lootTypeLabel
      !text: tr('Loot Type:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px
      visible: true

    Label
      id: lootType
      !text: tr('Leader')
      anchors.top: session.bottom
      anchors.right: parent.right
      margin-top: 5
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px
      visible: true

    Label
      id: lootLabel
      !text: tr('Loot:')
      anchors.top: lootType.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/icon_gold
      anchors.top: lootType.bottom
      anchors.right: parent.right
      margin-top: 8

    Label
      id: loot
      !text: tr('0')
      anchors.top: lootType.bottom
      anchors.right: prev.left
      margin-top: 5
      margin-right: 4
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px

    Label
      id: suppliesLabel
      !text: tr('Supplies:')
      anchors.top: lootLabel.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/icon_gold
      anchors.top: lootLabel.bottom
      anchors.right: parent.right
      margin-top: 8

    Label
      id: supplies
      !text: tr('0')
      anchors.top: lootLabel.bottom
      anchors.right: prev.left
      margin-top: 5
      margin-right: 4
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px

    Label
      id: balanceLabel
      !text: tr('Balance:')
      anchors.top: suppliesLabel.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: #c0c0c0
      font: Verdana Bold-11px

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/icon_gold
      anchors.top: suppliesLabel.bottom
      anchors.right: parent.right
      margin-top: 8

    Label
      id: balance
      !text: tr('0')
      anchors.top: suppliesLabel.bottom
      anchors.right: prev.left
      margin-top: 5
      margin-right: 4
      text-auto-resize: true
      color: #44ad25
      font: Verdana Bold-11px

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    Panel
      id: party
      size: 147 31
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      layout:
        type: verticalBox

  ScrollablePanel
    id: lootPanel
    anchors.fill: parent
    margin: 38 18 5 5
    visible: false
    layout:
      type: verticalBox

    UIWidget
      id: header
      height: 15

      Label
        id: count
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        font: verdana-11px-monochrome
        color: #a8a8a8
        text-auto-resize: true

      UIWidget
        id: goldIcon
        size: 9 9
        image-auto-resize: true
        image-source: /game_cyclopedia/images/icon_gold
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 2

      Label
        id: total
        anchors.right: goldIcon.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 4
        font: Verdana Bold-11px
        color: #e8d27a
        text-auto-resize: true

    Panel
      id: actions
      height: 17
      margin-top: 3

      PartyLootSmallButton
        id: split
        !text: tr('Dividir loot')
        anchors.fill: parent
        @onClick: modules.game_analyser.PartyLoot.send('propose')

      PartyLootSmallButton
        id: accept
        !text: tr('Aceitar')
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.horizontalCenter
        margin-right: 1
        color: #7be07b
        visible: false
        @onClick: modules.game_analyser.PartyLoot.send('accept')

      PartyLootSmallButton
        id: cancel
        !text: tr('Cancelar')
        anchors.top: parent.top
        anchors.left: parent.horizontalCenter
        anchors.right: parent.right
        margin-left: 1
        visible: false
        @onClick: modules.game_analyser.PartyLoot.send('cancel')

    Panel
      id: proposal
      visible: false
      margin-top: 4
      padding: 4
      background-color: #00000066
      border-width: 1
      border-color: #3c3c3c
      layout:
        type: verticalBox
        fit-children: true

    Label
      id: dropsTitle
      margin-top: 6
      font: verdana-11px-monochrome
      color: #9d9d9d
      !text: tr('Drops')
      text-auto-resize: true

    HorizontalSeparator
      margin-top: 2

    Panel
      id: drops
      margin-top: 1
      layout:
        type: verticalBox
        fit-children: true

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 2
    margin-bottom: 2

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 60
    margin-left: 3
    margin-right: 3
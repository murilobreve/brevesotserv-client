UIWidget
  anchors.fill: parent
  visible: false
  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 55

    QtButton
      !text: tr('Reset Settings')
      size: 130 20
      margin-bottom: 10
      margin-right: 10
      anchors.left: parent.left
      anchors.top: parent.top
      @onClick: modules.client_options.confirmResetSettings()
    QtButton
      !text: tr('Change language')
      size: 130 20
      margin-top: 5
      anchors.top: prev.bottom
      anchors.left: parent.left
      @onClick: |
        modules.client_locales.createWindow()

HealBotCategory < BrevesTab
  margin-top: 2
  text-align: left
  text-offset: 30 0
  $checked:
    text-offset: 30 0

  UIWidget
    id: icon
    size: 13 13
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    phantom: true

HealBotHint < BrevesNote
  margin-bottom: 4

// opens the next empty rule of a page (healbot.lua: addRules)
HealBotAdd < MythosButton
  height: 22
  font: verdana-11px-antialised

HealBotPage < UIWidget
  anchors.fill: parent
  layout:
    type: verticalBox
    spacing: 6
  visible: false

HealBotSlider < MythosHSlider
  width: 96
  minimum: 1
  maximum: 99
  step: 1

// the percentage, typed; the slider follows it (healbot.lua)
HealBotPercent < MythosTextEdit
  width: 34
  height: 20
  max-length: 2
  text-align: center

HealBotRule < BrevesPanelBox
  height: 42

  QtCheckBox
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  UIWidget
    id: icon
    size: 32 32
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    background-color: #00000066
    border-width: 1
    border-color: #4a3670

  MythosComboBox
    id: choice
    width: 150
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8

HealBotStatRule < HealBotRule
  MythosComboBox
    id: stat
    width: 64
    anchors.left: choice.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8

  HealBotSlider
    id: below
    anchors.left: stat.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #e6e0f2
    text: %

SpellRule < HealBotStatRule

PotionRule < HealBotStatRule
  Item
    id: item
    size: 32 32
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    virtual: true

FriendRule < HealBotRule
  HealBotSlider
    id: below
    anchors.left: choice.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #e6e0f2
    text: %

  // the whole party, anyone, or one party member
  MythosComboBox
    id: target
    width: 104
    anchors.left: belowLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    !tooltip: tr('Who to heal')

SupportRule < HealBotRule
  Label
    id: note
    anchors.left: choice.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    font: verdana-11px-monochrome
    color: #9789b3
    text-wrap: true
    text-auto-resize: true

// the magic shield: the spell and the health it comes on at (100: always)
ShieldRule < HealBotRule
  Label
    id: label
    anchors.left: choice.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-monochrome
    color: #9789b3
    !text: tr('Health up to')
    text-auto-resize: true

  HealBotSlider
    id: below
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 70
    minimum: 10
    maximum: 100

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 40
    max-length: 3

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #e6e0f2
    text: %

// exana vita: the health from which the magic shield is taken off
UnshieldRule < BrevesPanelBox
  height: 42

  QtCheckBox
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  UIWidget
    id: icon
    size: 32 32
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    border-width: 1
    border-color: #4a3670

  Label
    id: label
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-monochrome
    color: #9789b3
    !text: tr('Remove the shield (exana vita): health from')
    text-auto-resize: true

  HealBotSlider
    id: below
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 70
    minimum: 20

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #e6e0f2
    text: %

// train magic level: the spell and the mana it is cast from
TrainRule < HealBotRule
  Label
    id: label
    anchors.left: choice.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-monochrome
    color: #9789b3
    !text: tr('Train ML: mana from')
    text-auto-resize: true

  HealBotSlider
    id: below
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 60
    minimum: 10

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #e6e0f2
    text: %

CureRule < BrevesPanelBox
  height: 42

  QtCheckBox
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  Label
    id: note
    anchors.left: enabled.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-monochrome
    color: #cbc0e0
    text-wrap: true
    text-auto-resize: true

MythosWindow
  id: healBotWindow
  !text: tr('Heal Bot')
  size: 640 428
  @onEscape: modules.game_healbot.hide()

  UIWidget
    id: categories
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: separator.top
    width: 128
    margin-bottom: 8
    padding: 4 4 4 4
    image-source: /images/mythos/panel
    image-border: 4
    layout: verticalBox

    HealBotCategory
      id: healing
      !text: tr('Heal spells')
    HealBotCategory
      id: potions
      !text: tr('Potions')
    HealBotCategory
      id: friends
      !text: tr('Friends')
    HealBotCategory
      id: support
      !text: tr('Support')
    HealBotCategory
      id: loot
      !text: tr('Loot')

  BrevesPanelBox
    id: content
    anchors.top: parent.top
    anchors.left: categories.right
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-left: 8
    margin-bottom: 8

    HealBotPage
      id: healingPage

    HealBotPage
      id: potionsPage

    HealBotPage
      id: friendsPage

    HealBotPage
      id: supportPage

    HealBotPage
      id: lootPage
      BrevesNote
        id: state
        color: #cbc0e0
      MythosPrimaryButton
        id: open
        size: 200 22
        !text: tr('Choose what to loot')

  MythosSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: ok.top
    margin-bottom: 8

  QtCheckBox
    id: master
    anchors.left: parent.left
    anchors.verticalCenter: ok.verticalCenter
    width: 100
    !text: tr('Bot on')
    @onCheckChange: modules.game_healbot.setRunning(self:isChecked())

  Label
    id: status
    anchors.left: master.right
    anchors.right: ok.left
    anchors.verticalCenter: ok.verticalCenter
    margin-left: 12
    margin-right: 12
    font: verdana-11px-monochrome
    color: #9789b3
    text-auto-resize: false

  MythosPrimaryButton
    id: ok
    size: 64 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Ok')
    @onClick: modules.game_healbot.hide()

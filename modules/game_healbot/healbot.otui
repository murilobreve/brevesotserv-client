HealBotCategory < BrevesTab
  margin-top: 2
  text-align: left
  text-offset: 30 0
  $checked:
    text-offset: 30 0

  UIWidget
    id: icon
    size: 13 13
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    phantom: true

HealBotHint < BrevesNote
  margin-bottom: 4

// opens the next empty rule of a page (healbot.lua: addRules)
HealBotAdd < MythosButton
  height: 22
  font: verdana-11px-antialised

HealBotPage < UIWidget
  anchors.fill: parent
  layout:
    type: verticalBox
    spacing: 6
  visible: false

HealBotSlider < MythosHSlider
  width: 96
  minimum: 1
  maximum: 99
  step: 1

// the percentage, typed; the slider follows it (healbot.lua)
HealBotPercent < MythosTextEdit
  width: 34
  height: 20
  max-length: 2
  text-align: center

HealBotRule < BrevesPanelBox
  height: 42

  QtCheckBox
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  UIWidget
    id: icon
    size: 32 32
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    background-color: #00000066
    border-width: 1
    border-color: #272727

  MythosComboBox
    id: choice
    width: 150
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8

HealBotStatRule < HealBotRule
  MythosComboBox
    id: stat
    width: 64
    anchors.left: choice.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8

  HealBotSlider
    id: below
    anchors.left: stat.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #dfdfdf
    text: %

SpellRule < HealBotStatRule

PotionRule < HealBotStatRule
  Item
    id: item
    size: 32 32
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    virtual: true

FriendRule < HealBotRule
  HealBotSlider
    id: below
    anchors.left: choice.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #dfdfdf
    text: %

  // the whole party, anyone, or one party member
  MythosComboBox
    id: target
    width: 104
    anchors.left: belowLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    !tooltip: tr('Who to heal')

SupportRule < HealBotRule
  Label
    id: note
    anchors.left: choice.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    font: verdana-11px-monochrome
    color: #909090
    text-wrap: true
    text-auto-resize: true

// the magic shield: the spell and the health it comes on at (100: always)
ShieldRule < HealBotRule
  Label
    id: label
    anchors.left: choice.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-monochrome
    color: #909090
    !text: tr('Health up to')
    text-auto-resize: true

  HealBotSlider
    id: below
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 70
    minimum: 10
    maximum: 100

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 40
    max-length: 3

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #dfdfdf
    text: %

// exana vita: the health from which the magic shield is taken off
UnshieldRule < BrevesPanelBox
  height: 42

  QtCheckBox
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  UIWidget
    id: icon
    size: 32 32
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    border-width: 1
    border-color: #272727

  Label
    id: label
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-monochrome
    color: #909090
    !text: tr('Remove the shield (exana vita): health from')
    text-auto-resize: true

  HealBotSlider
    id: below
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 70
    minimum: 20

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #dfdfdf
    text: %

// The caster page (healbot.lua, fillCaster): its switch, the preset and its
// name, the options, and the list of rules that scrolls. A rule is one
// line: its place in the order, on or off, the spell (or rune), the mana it
// needs left, the health its target must still have, how many monsters it
// waits for, and the buttons that move it up or down and take it out. The
// boxes are anchored from the right, so the names of the columns
// (CasterHeading) stand over them whatever the width.
CasterButton < MythosButton
  size: 20 20
  font: verdana-11px-antialised
  text-offset: 0 0

CasterRow < BrevesPanelBox
  height: 36

  Label
    id: order
    width: 14
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    font: verdana-11px-antialised
    color: #dfdfdf
    text-align: center

  QtCheckBox
    id: enabled
    anchors.left: order.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  CasterButton
    id: remove
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    text: x

  CasterButton
    id: down
    anchors.right: remove.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    text: v

  CasterButton
    id: up
    anchors.right: down.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    text: ^

  MythosComboBox
    id: count
    width: 50
    anchors.right: up.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8

  HealBotPercent
    id: hp
    anchors.right: count.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 22

CasterSpellRow < CasterRow
  UIWidget
    id: icon
    size: 28 28
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    border-width: 1
    border-color: #272727

  HealBotPercent
    id: below
    anchors.right: hp.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 22

  MythosComboBox
    id: choice
    anchors.left: icon.right
    anchors.right: below.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 10
    text-align: left
    text-offset: 6 0

CasterRuneRow < CasterRow
  Item
    id: item
    size: 28 28
    anchors.left: enabled.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    virtual: true

  MythosComboBox
    id: choice
    anchors.left: item.right
    anchors.right: hp.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 66
    text-align: left
    text-offset: 6 0

// the name of a column, in the middle over its box
CasterColumn < Label
  width: 56
  anchors.bottom: parent.bottom
  font: verdana-11px-antialised
  color: #909090
  text-align: center

// the heading of a part of the list ("Spells", "Runes") and, at the right,
// the names of the columns of its rules. The margins are those of a rule's
// boxes plus the 8 of the rule's own padding.
CasterHeading < UIWidget
  height: 18

  CasterColumn
    id: count
    width: 58
    anchors.right: parent.right
    margin-right: 78
    !text: tr('monsters')

  CasterColumn
    id: hp
    anchors.right: parent.right
    margin-right: 143
    !text: tr('target %')
    !tooltip: tr('Used only on a target with this much health or more. 0: on any.')

  CasterColumn
    id: mana
    anchors.right: parent.right
    margin-right: 199
    !text: tr('mana %')
    !tooltip: tr('Cast only with this much mana or more.')

  Label
    id: title
    anchors.left: parent.left
    anchors.right: mana.left
    anchors.bottom: parent.bottom
    margin-right: 6
    font: verdana-11px-antialised
    color: #dfdfdf

CasterPage < UIWidget
  anchors.fill: parent
  visible: false

  QtCheckBox
    id: on
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 4
    margin-left: 4
    width: 150
    !text: tr('Caster on')

  MythosTextEdit
    id: presetName
    anchors.verticalCenter: on.verticalCenter
    anchors.right: parent.right
    margin-right: 4
    width: 120
    height: 20
    max-length: 16

  MythosComboBox
    id: preset
    anchors.verticalCenter: on.verticalCenter
    anchors.right: presetName.left
    margin-right: 6
    width: 130
    text-align: left
    text-offset: 6 0

  Label
    id: presetLabel
    anchors.verticalCenter: on.verticalCenter
    anchors.right: preset.left
    margin-right: 6
    font: verdana-11px-antialised
    color: #909090
    !text: tr('Preset')
    text-auto-resize: true

  QtCheckBox
    id: noPlayers
    anchors.top: on.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 4
    width: 300
    !text: tr('Wait with a stranger on screen')

  QtCheckBox
    id: runesFirst
    anchors.verticalCenter: noPlayers.verticalCenter
    anchors.left: noPlayers.right
    margin-left: 8
    width: 200
    !text: tr('Runes before the spells')

  QtCheckBox
    id: autoAttack
    anchors.top: noPlayers.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 4
    width: 300
    !text: tr('Attack the next monster by itself')

  // which monster the auto attack takes
  MythosComboBox
    id: pick
    anchors.verticalCenter: autoAttack.verticalCenter
    anchors.left: autoAttack.right
    margin-left: 8
    width: 130
    text-align: left
    text-offset: 6 0

  // no attack with the character's own health under this
  QtCheckBox
    id: safe
    anchors.top: autoAttack.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 4
    width: 300
    !text: tr('Stop attacking with my health under')

  HealBotPercent
    id: safeHp
    anchors.verticalCenter: safe.verticalCenter
    anchors.left: safe.right
    margin-left: 8

  Label
    id: safePercent
    width: 12
    anchors.left: safeHp.right
    anchors.verticalCenter: safeHp.verticalCenter
    margin-left: 3
    color: #dfdfdf
    text: %

  MythosSeparator
    id: rule
    anchors.top: safe.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  MythosScrollBar
    id: scroll
    anchors.top: rule.bottom
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
    step: 20
    pixels-scroll: true

  ScrollablePanel
    id: list
    anchors.top: rule.bottom
    anchors.left: parent.left
    anchors.right: scroll.left
    anchors.bottom: parent.bottom
    margin-top: 6
    margin-right: 4
    vertical-scrollbar: scroll
    layout:
      type: verticalBox
      spacing: 4

TrainRule < HealBotRule
  Label
    id: label
    anchors.left: choice.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-monochrome
    color: #909090
    !text: tr('Train ML: mana from')
    text-auto-resize: true

  HealBotSlider
    id: below
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 60
    minimum: 10

  HealBotPercent
    id: belowEdit
    anchors.left: below.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: belowLabel
    width: 12
    anchors.left: belowEdit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    color: #dfdfdf
    text: %

CureRule < BrevesPanelBox
  height: 42

  QtCheckBox
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  Label
    id: note
    anchors.left: enabled.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-monochrome
    color: #c0c0c0
    text-wrap: true
    text-auto-resize: true

MythosWindow
  id: healBotWindow
  !text: tr('Heal Bot')
  size: 760 560
  @onEscape: modules.game_healbot.hide()

  UIWidget
    id: categories
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: separator.top
    width: 128
    margin-bottom: 8
    padding: 4 4 4 4
    image-source: /images/ui/panel_flat
    image-border: 1
    layout: verticalBox

    HealBotCategory
      id: healing
      !text: tr('Heal spells')
    HealBotCategory
      id: potions
      !text: tr('Potions')
    HealBotCategory
      id: friends
      !text: tr('Friends')
    HealBotCategory
      id: support
      !text: tr('Support')
    HealBotCategory
      id: caster
      !text: tr('Caster')
    HealBotCategory
      id: loot
      !text: tr('Loot')

  BrevesPanelBox
    id: content
    anchors.top: parent.top
    anchors.left: categories.right
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-left: 8
    margin-bottom: 8

    HealBotPage
      id: healingPage

    HealBotPage
      id: potionsPage

    HealBotPage
      id: friendsPage

    HealBotPage
      id: supportPage

    CasterPage
      id: casterPage

    HealBotPage
      id: lootPage
      BrevesNote
        id: state
        color: #c0c0c0
      MythosPrimaryButton
        id: open
        size: 200 22
        !text: tr('Choose what to loot')

  MythosSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: ok.top
    margin-bottom: 8

  QtCheckBox
    id: master
    anchors.left: parent.left
    anchors.verticalCenter: ok.verticalCenter
    width: 100
    !text: tr('Bot on')
    @onCheckChange: modules.game_healbot.setRunning(self:isChecked())

  Label
    id: status
    anchors.left: master.right
    anchors.right: ok.left
    anchors.verticalCenter: ok.verticalCenter
    margin-left: 12
    margin-right: 12
    font: verdana-11px-monochrome
    color: #909090
    text-auto-resize: false

  MythosPrimaryButton
    id: ok
    size: 64 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Ok')
    @onClick: modules.game_healbot.hide()

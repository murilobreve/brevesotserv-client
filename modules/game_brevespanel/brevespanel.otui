// one button per server feature, in a line under its section's title; its
// width follows the text (brevespanel.lua), or only the icon on a narrow screen
BrevesFeatureButton < Button
  padding: 0
  height: 20
  font: verdana-11px-rounded
  color: #dfdfdf
  text-align: left
  text-offset: 23 0
  change-cursor-image: true
  cursor: pointer
  $hover !on:
    color: #dfdfdf
  $on:
    color: #dfdfdf

  // the gold light that pulses over the row when its number goes up
  UIWidget
    id: glow
    anchors.fill: parent
    background-color: #909090
    phantom: true
    visible: false

  UIWidget
    id: icon
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    phantom: true

  // a state such as ON / OFF
  Label
    id: badge
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    height: 14
    text-auto-resize: true
    text-align: center
    padding: 1 4 0 4
    font: verdana-9px-bold
    border-color: #747474
    phantom: true
    visible: false
    $hover:
      border-color: #c0c0c0

  // a pill over the row's top right corner (setFeatureFlag): the best hunt
  // rate over Teleports, the spins the Roulette has
  Label
    id: flag
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -10
    margin-right: -6
    height: 12
    text-auto-resize: true
    text-align: center
    padding: 0 4 0 4
    font: verdana-9px-bold
    color: #ffffff
    border-width: 1
    border-color: #ffffffcc
    phantom: true
    visible: false

  // a quick action on the row, e.g. the hunt teleport of the Trail row
  Button
    text-offset: 0 0
    id: action
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    height: 15
    text-auto-resize: true
    padding: 1 5 0 5
    font: verdana-9px-bold
    color: #dfdfdf
    cursor: pointer
    visible: false
    $hover !disabled:
      color: #ffffff
    $disabled:
      color: #707070

  // what the quick action does, drawn over its left end (setFeatureAction):
  // the portal of a teleport. The action's text leaves it the room
  UIWidget
    id: actionIcon
    size: 11 11
    anchors.left: action.left
    anchors.verticalCenter: action.verticalCenter
    margin-left: 3
    phantom: true
    visible: false

// the row the bar wants seen first (Teleports: hunts, bosses and quests):
// gold text in a gold frame, at the rows' own height
BrevesPrimaryButton < BrevesFeatureButton
  font: Verdana Bold-11px
  color: #dfdfdf
  background-color: #585858
  border-width: 1
  border-color: #c0c0c0
  $hover !on:
    background-color: #585858
    color: #ffffff
    border-color: #c0c0c0
  $pressed:
    background-color: #585858
  $on:
    background-color: #585858
    color: #ffffff
    border-color: #c0c0c0

// The pages of the teleports (Hunts, Bosses, Quests) under the title bar of
// each of their windows: the strip of pages of Tibia's Cyclopedia. A page is
// a button with its icon and name and, for bosses and quests, how many wait;
// the page that shows stays pressed (brevespanel.lua: attachHub).
BrevesHubStrip < UIWidget
  height: 36
  background-color: #404040
  border-width-top: 1
  border-color-top: black
  border-width-left: 1
  border-color-left: black
  border-width-bottom: 1
  border-color-bottom: #747474
  border-width-right: 1
  border-color-right: #747474

BrevesHubTab < Button
  size: 150 28
  padding: 0
  font: verdana-11px-antialised
  color: #c0c0c0
  text-offset: 8 0
  change-cursor-image: true
  cursor: pointer

  $hover !checked:
    color: #ffffff

  $checked:
    color: #ffffff

  UIWidget
    id: icon
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    phantom: true

  Label
    id: count
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    height: 14
    text-auto-resize: true
    text-align: center
    font: verdana-11px-antialised
    color: #60f860
    phantom: true
    visible: false

// the "+N" that rises from a badge when its number goes up
// sized from its text in brevespanel.lua (auto resize misreads the TTF font)
BrevesGainLabel < Label
  text-align: center
  font: Verdana Bold-11px
  color: #dfdfdf
  background-color: #363636e6
  border-width: 1
  border-color: #c0c0c0
  phantom: true
  focusable: false

// the VIP button: the site's gold button, at the right end of the bar
BrevesVipButton < BrevesFeatureButton
  height: 24
  anchors.left: parent.left
  anchors.verticalCenter: parent.verticalCenter
  font: Verdana Bold-11px
  color: #dfdfdf
  text-align: center
  text-offset: 8 1
  // the site's gold button scaled evenly to 24px (see MythosKitGoldButton28)
  image-source: /images/mythos/kit_gold_24
  image-border-left: 18
  image-border-right: 18
  $hover !on:
    image-source: /images/mythos/kit_gold_24_hover
    background-color: #00000000
    color: #ffffff
  $pressed:
    image-source: /images/mythos/kit_gold_24_pressed
    background-color: #00000000
  $on:
    image-source: /images/mythos/kit_gold_24_pressed
    background-color: #00000000
    color: #ffffff

// holds the VIP button at its own 24px height: the bar's line layout would
// stretch it to the sections' height and repeat the gold art
BrevesVipHolder < UIWidget
  phantom: true

// one of the four sections (Tasks, Hunts, Rarity, Tools): a framed block with
// a gold-trimmed title and its buttons in a line under it
BrevesSector < UIWidget
  height: 47
  image-source: /images/mythos/sector
  image-border: 4
  phantom: true

  UIWidget
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    // the site's dark gold button scaled evenly to 22px, so the trim above
    // and below stays the same; only the middle stretches sideways
    image-source: /images/mythos/sector_header
    image-border-left: 20
    image-border-right: 20
    phantom: true

  UIWidget
    id: icon
    size: 16 16
    anchors.left: header.left
    anchors.verticalCenter: header.verticalCenter
    margin-left: 18
    phantom: true

  Label
    id: title
    anchors.left: icon.right
    anchors.verticalCenter: header.verticalCenter
    margin-left: 6
    margin-top: 1
    text-auto-resize: true
    color: #dfdfdf
    font: Verdana Bold-11px
    phantom: true

  UIWidget
    id: rows
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 2 4 3 4
    phantom: true
    layout:
      type: horizontalBox
      spacing: 2

// the Mythos bar: over the bottom of the game screen, just above the spell
// bar, across the width of the map. Its background lets the game show
// through, and a click off its buttons reaches the map.
BrevesBar < UIWidget
  id: brevespanel
  height: 53
  background-color: #00000000
  focusable: false
  phantom: true

  UIWidget
    id: strip
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 3
    height: 47
    phantom: true
    layout:
      type: horizontalBox
      spacing: 4
      fit-children: true

  // the sections that do not fit on the first line (a narrow map): the
  // bar keeps every name and grows a second line instead
  UIWidget
    id: strip2
    anchors.top: strip.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 3
    height: 47
    phantom: true
    visible: false
    layout:
      type: horizontalBox
      spacing: 4
      fit-children: true

  // starts the Mythos tour again (game_tutorial)
  // folds the bar to a thin line (open again on every login)
  Button
    padding: 0
    text-offset: 0 0
    font: verdana-11px-antialised
    id: collapseButton
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 4
    margin-left: 4
    size: 14 14
    icon-source: /images/mythos/fold_open
    icon-size: 8 8
    icon-align: center
    cursor: pointer
    !tooltip: tr('Hide the Mythos bar')
    @onClick: modules.game_brevespanel.toggleCollapsed()
    $on:
      icon-source: /images/mythos/fold_closed

  // the folded bar: one line, a click anywhere opens it again
  UIButton
    id: collapsedLabel
    anchors.left: collapseButton.right
    anchors.right: parent.right
    anchors.verticalCenter: collapseButton.verticalCenter
    margin-left: 4
    height: 14
    text-align: left
    font: verdana-11px-rounded
    color: #dfdfdf
    cursor: pointer
    visible: false
    !text: tr('Mythos: Tasks, Hunts, Rarity, Tools and VIP. Click to open.')
    @onClick: modules.game_brevespanel.toggleCollapsed()
    $hover:
      color: #dfdfdf

  // on the left corner, under the fold button, clear of the VIP button
  UIButton
    id: tutorialButton
    anchors.left: parent.left
    anchors.top: collapseButton.bottom
    margin-top: 4
    margin-left: 5
    size: 12 14
    text: ?
    font: verdana-11px-rounded
    color: #707070
    cursor: pointer
    !tooltip: tr('Tutorial: a quick tour of Mythos')
    @onClick: if modules.game_tutorial then modules.game_tutorial.start() end
    $hover:
      color: #dfdfdf

// ---------------------------------------------------------------- news window

BrevesNewsRow < UIWidget
  height: 62

  UIWidget
    id: icon
    size: 32 32
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 4
    phantom: true

  Label
    id: name
    anchors.left: icon.right
    anchors.top: parent.top
    margin-left: 10
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #dfdfdf

  Label
    id: text
    anchors.left: name.left
    anchors.right: open.left
    anchors.top: name.bottom
    margin-top: 3
    margin-right: 10
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #c0c0c0

  MythosButton
    id: open
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 8
    size: 60 22
    !text: tr('Open')

BrevesNewsWindow < MythosWindow
  id: brevesNewsWindow
  !text: tr('New on Mythos')
  size: 470 440
  @onEscape: modules.game_brevespanel.hideNews()

  Label
    id: intro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #dfdfdf
    !text: tr('Everything is in the Mythos bar, under the game screen.')

  MythosSeparator
    id: topSep
    anchors.top: intro.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  UIWidget
    id: rows
    anchors.top: topSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomSep.top
    margin-top: 8
    layout:
      type: verticalBox
      spacing: 4

  MythosSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  MythosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 60 22
    !text: tr('Close')
    @onClick: modules.game_brevespanel.hideNews()

// a small notice over the top right corner of the game screen; it never takes
// the focus, so walking and hotkeys keep working
BrevesNotice < MythosBox
  width: 250
  height: 72
  padding: 10 8 8 10

  Label
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #dfdfdf
    phantom: true

  MythosPrimaryButton
    id: openButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 86
    height: 20
    focusable: false

  MythosButton
    id: closeButton
    !text: tr('Later')
    anchors.right: openButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    width: 60
    height: 20
    focusable: false

// ---------------------------------------------------------------- callout

// the callout's tip: a square turned on its corner, half under the box, so
// the gold rim runs down to a point over the row
BrevesCalloutTip < UIWidget
  size: 12 12
  background-color: #484848
  border-width: 1
  border-color: #c0c0c0
  rotation: 45
  phantom: true
  focusable: false

// a callout over a row of the bar (NEW RATES over Teleports), as the website
// draws its cards: the obsidian glass with the gold rim, the title in Cinzel
// over the crystal divider. A click on it opens the row; the x closes it.
// Its height and place come from brevespanel.lua (point)
BrevesCallout < UIButton
  width: 236
  height: 110
  focusable: false
  cursor: pointer

  // first, so the box covers its upper half
  BrevesCalloutTip
    id: tip
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 2

  UIWidget
    id: box
    anchors.fill: parent
    margin-bottom: 8
    image-source: /images/mythos/notice
    image-border: 4
    phantom: true

  // the website's violet line along the top, like the rarity on an item card
  UIWidget
    id: accent
    anchors.top: box.top
    anchors.left: box.left
    anchors.right: box.right
    margin: 3 3 0 3
    height: 2
    background-color: #c0c0c0
    phantom: true

  Label
    id: title
    anchors.top: box.top
    anchors.left: box.left
    anchors.right: closeButton.left
    margin-top: 8
    margin-left: 12
    height: 18
    font: Verdana Bold-11px
    color: #dfdfdf
    phantom: true

  Button
    padding: 0
    text-offset: 0 0
    id: closeButton
    anchors.top: box.top
    anchors.right: box.right
    margin-top: 6
    margin-right: 6
    size: 16 16
    text: x
    font: verdana-11px-rounded
    color: #dfdfdf
    cursor: pointer
    !tooltip: tr('Close')
    $hover:
      color: #dfdfdf

  // the site's divider: a gold rod with the violet crystal in the middle
  UIWidget
    id: divider
    anchors.top: title.bottom
    anchors.horizontalCenter: box.horizontalCenter
    size: 150 23
    image-source: /game_brevespanel/images/divider
    phantom: true

  Label
    id: text
    anchors.top: divider.bottom
    anchors.left: box.left
    anchors.right: box.right
    margin-left: 12
    margin-right: 12
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #dfdfdf
    phantom: true

  Label
    id: detail
    anchors.top: text.bottom
    anchors.left: text.left
    anchors.right: text.right
    margin-top: 3
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #ffffff
    phantom: true

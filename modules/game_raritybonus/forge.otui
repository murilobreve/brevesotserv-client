// Forja de Raridade, in the way of Tibia's own forge: a small window with
// tabs (Roll, Upgrade, My bonuses), the rare items as 32px slots (worn on
// top, the backpack's below), the item picked on the right. Roll: one line
// per bonus with a box to keep it, then a wheel that picks each new bonus's
// type and a needle meter that picks its value. Upgrade: the item and its
// next grade, the chance and the price; a bar while it forges, then the
// result. My bonuses: the totals of what is worn, with their limits.
// Pictures: images/forge (wheel/: one wheel per number of slices).

ForgeTab < UIButton
  height: 22
  text-auto-resize: true
  padding: 0 14
  font: verdana-11px-antialised
  color: #9c9c9c
  background-color: #262626
  border-width: 1
  border-color: #444444
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    color: #e0e0e0

  $on:
    color: #ffffff
    background-color: #333333
    border-color: #5a5a5a

// a sunken box (Tibia's inset panels)
ForgeInset < UIWidget
  background-color: #1e1e1e
  border-width: 1
  border-color: #121212

// a raised box
ForgePanel < UIWidget
  background-color: #262626
  border-width: 1
  border-color: #161616

ForgeDim < Label
  font: verdana-11px-antialised
  color: #8c8c8c

ForgeText < Label
  font: verdana-11px-antialised
  color: #c8c8c8

ForgeButton < MythosButton
  height: 22

// one rare item as a slot: its grade is the frame's colour
ForgeSlot < UIButton
  size: 36 36
  background-color: #1a1a1a
  border-width: 2
  change-cursor-image: true
  cursor: pointer

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: parent
    virtual: true
    phantom: true

// one bonus of the item: keep box, text, how it changed, range, quality
ForgeRow < UIWidget
  height: 22

  CheckBox
    id: seal
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    size: 14 14

  Label
    id: text
    anchors.left: seal.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    text-auto-resize: true
    font: verdana-11px-antialised

  Label
    id: delta
    anchors.left: text.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-auto-resize: true
    font: Verdana Bold-10px

  Label
    id: quality
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 64
    text-align: right
    font: verdana-11px-antialised

  Label
    id: range
    anchors.right: quality.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #8c8c8c

  UIWidget
    id: line
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #2f2f2f
    phantom: true

// a bonus's picture on its slice of the wheel
ForgeWheelIcon < UIWidget
  size: 20 20
  phantom: true

// one total of My bonuses
ForgeTotalRow < UIWidget
  height: 21

  Label
    id: name
    anchors.left: parent.left
    anchors.right: total.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    font: verdana-11px-antialised
    color: #d0d0d0

  Label
    id: cap
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 70
    text-align: right
    font: verdana-11px-antialised
    color: #8c8c8c

  Label
    id: total
    anchors.right: cap.left
    anchors.verticalCenter: parent.verticalCenter
    width: 80
    text-align: right
    font: Verdana Bold-11px
    color: #e6e6e6

  UIWidget
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #2f2f2f
    phantom: true

// a line of the upgrade's result
ForgeResultLine < Label
  height: 15
  text-auto-resize: true
  font: verdana-11px-antialised

MythosWindow
  id: forgeWindow
  !text: tr('Rarity Forge')
  size: 680 600
  @onEscape: modules.game_raritybonus.hide()

  UIButton
    id: closeX
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -34
    margin-right: -8
    size: 22 22
    text: X
    font: Verdana Bold-11px
    color: #d6cfc2
    background-color: #2a2219
    border-width: 1
    border-color: #6b5631
    change-cursor-image: true
    cursor: pointer
    !tooltip: tr('Close')
    @onClick: modules.game_raritybonus.hide()

    $hover:
      color: #ffffff
      background-color: #3d2f20
      border-color: #a8884a

  UIWidget
    id: tabs
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 4
    height: 22
    width: 400
    layout:
      type: horizontalBox
      spacing: 2

    ForgeTab
      id: tabRoll
      !text: tr('Roll')
      @onClick: modules.game_raritybonus.forgeTab('roll')

    ForgeTab
      id: tabUp
      !text: tr('Upgrade')
      @onClick: modules.game_raritybonus.forgeTab('up')

    ForgeTab
      id: tabTotals
      !text: tr('My bonuses')
      @onClick: modules.game_raritybonus.forgeTab('totals')

  // Rarity XP, the shop, what the last action did, the gold
  ForgePanel
    id: bottomBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26

    UIWidget
      id: xpIcon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      size: 16 16
      image-source: /game_raritybonus/images/forge/ui/rarity_xp

    ForgeText
      id: xpLabel
      anchors.left: xpIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      text-auto-resize: true
      font: Verdana Bold-11px
      color: #c9a4ff

    ForgeButton
      id: buyXpButton
      anchors.left: xpLabel.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      size: 70 18
      !text: tr('Buy')
      !tooltip: tr('Buy Rarity XP here, with Mythos Coins or Hunt Points.')
      @onClick: modules.game_raritybonus.buyRarityXp()

    UIWidget
      id: goldIcon
      anchors.right: bankBox.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 5
      size: 16 16
      image-source: /images/game/cyclopedia/icons/icon-goldcoin

    ForgeText
      id: bankBox
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      text-auto-resize: true
      font: Verdana Bold-11px
      color: #e2c46a

    Label
      id: status
      anchors.left: buyXpButton.right
      anchors.right: goldIcon.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      margin-right: 10
      height: 14
      text-align: center
      font: verdana-11px-antialised
      color: #7fd35a

  ForgePanel
    id: body
    anchors.top: tabs.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomBar.top
    margin-bottom: 6
    background-color: #333333
    border-color: #5a5a5a
    padding: 6

    // ---------------------------------------------------------- the items
    ForgePanel
      id: left
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 172
      padding: 6

      ForgeDim
        id: wornTitle
        anchors.top: parent.top
        anchors.left: parent.left
        text-auto-resize: true
        color: #a8a8a8
        !text: tr('Equipped items')

      UIWidget
        id: wornGrid
        anchors.top: wornTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        height: 36
        layout:
          type: grid
          cell-size: 36 36
          cell-spacing: 4
          num-columns: 4

      UIWidget
        id: bagRule
        anchors.top: wornGrid.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        height: 1
        background-color: #3c3c3c
        phantom: true

      ForgeDim
        id: bagTitle
        anchors.top: bagRule.bottom
        anchors.left: parent.left
        margin-top: 6
        text-auto-resize: true
        color: #a8a8a8
        !text: tr('In the backpack')

      ForgeDim
        id: bagNote
        anchors.verticalCenter: bagTitle.verticalCenter
        anchors.right: parent.right
        text-auto-resize: true
        font: Verdana-10px-antialiased

      ScrollablePanel
        id: bagGrid
        anchors.top: bagTitle.bottom
        anchors.left: parent.left
        anchors.right: bagScroll.left
        anchors.bottom: leftHint.top
        margin-top: 5
        margin-bottom: 6
        vertical-scrollbar: bagScroll
        layout:
          type: grid
          cell-size: 36 36
          cell-spacing: 4
          num-columns: 4

      VerticalScrollBar
        id: bagScroll
        anchors.top: bagTitle.bottom
        anchors.bottom: leftHint.top
        margin-top: 5
        margin-bottom: 6
        anchors.right: parent.right
        width: 8
        step: 40
        pixels-scroll: true

      ForgeDim
        id: leftHint
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 40
        text-wrap: true
        font: Verdana-10px-antialiased
        !text: tr('Hover an item to see its bonuses. Click to pick it.')

    // ------------------------------------------------- the item picked
    ForgePanel
      id: right
      anchors.top: parent.top
      anchors.left: left.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 6
      padding: 8 10 8 10

      UIWidget
        id: head
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 40

        ForgeSlot
          id: itemBox
          anchors.left: parent.left
          anchors.top: parent.top
          change-cursor-image: false

        Label
          id: name
          anchors.left: itemBox.right
          anchors.top: parent.top
          anchors.right: parent.right
          margin-left: 8
          margin-top: 3
          height: 15
          font: Verdana Bold-11px
          color: #e6e6e6

        Label
          id: info
          anchors.left: name.left
          anchors.top: name.bottom
          anchors.right: parent.right
          margin-top: 3
          height: 14
          font: verdana-11px-antialised

        UIWidget
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          height: 1
          background-color: #3c3c3c
          phantom: true

      ForgeDim
        id: empty
        anchors.centerIn: parent
        width: 440
        height: 60
        text-align: center
        text-auto-resize: false
        text-wrap: true
        !text: tr('You have no rarity item, worn or in the backpack.\nRarity items come from Pale, Ashen, Obsidian and Lord of Death monsters.')
        visible: false

      // ---------------------------------------------------- Roll
      UIWidget
        id: rollPage
        anchors.top: head.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom

        ForgeDim
          id: colKeep
          anchors.top: parent.top
          anchors.left: parent.left
          margin-top: 6
          text-auto-resize: true
          font: Verdana-10px-antialiased
          !text: tr('Keep / Bonus')

        ForgeDim
          id: colRange
          anchors.top: parent.top
          anchors.right: parent.right
          margin-top: 6
          margin-right: 74
          text-auto-resize: true
          font: Verdana-10px-antialiased
          !text: tr('Range')

        UIWidget
          id: rows
          anchors.top: colKeep.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 3
          height: 110
          layout:
            type: verticalBox

        ForgeDim
          id: emptySlots
          anchors.top: rows.bottom
          anchors.left: parent.left
          margin-left: 24
          height: 18
          text-auto-resize: true
          color: #707070

        ForgeInset
          id: wheelBox
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: hint.top
          margin-bottom: 6
          height: 204
          padding: 6

          UIWidget
            id: wheelHolder
            anchors.left: parent.left
            anchors.top: parent.top
            size: 184 192

            UIWidget
              id: wheel
              anchors.left: parent.left
              anchors.top: parent.top
              margin-left: 2
              margin-top: 10
              size: 180 180
              image-source: /game_raritybonus/images/forge/wheel/wheel_10

            UIWidget
              id: hub
              anchors.horizontalCenter: wheel.horizontalCenter
              anchors.verticalCenter: wheel.verticalCenter
              size: 16 16
              image-source: /game_raritybonus/images/forge/wheel/hub
              phantom: true

            UIWidget
              id: pointer
              anchors.horizontalCenter: wheel.horizontalCenter
              anchors.top: parent.top
              size: 20 18
              image-source: /game_raritybonus/images/forge/wheel/pointer
              phantom: true

          Label
            id: caption
            anchors.left: wheelHolder.right
            anchors.right: parent.right
            anchors.top: parent.top
            margin-left: 12
            margin-top: 8
            height: 32
            text-wrap: true
            font: Verdana Bold-11px
            color: #c8c8c8

          ForgeDim
            id: sub
            anchors.left: caption.left
            anchors.right: parent.right
            anchors.top: caption.bottom
            margin-top: 2
            height: 42
            text-wrap: true
            font: Verdana-10px-antialiased

          ForgeDim
            id: meterTitle
            anchors.left: caption.left
            anchors.bottom: meter.top
            margin-bottom: 5
            text-auto-resize: true
            font: Verdana-10px-antialiased
            color: #a8a8a8

          Label
            id: meterValue
            anchors.right: parent.right
            anchors.bottom: meter.top
            margin-bottom: 3
            text-auto-resize: true
            font: Verdana Bold-13px

          // where the value falls: weak, fair, good, excellent, perfect
          UIWidget
            id: meter
            anchors.left: caption.left
            anchors.right: parent.right
            anchors.top: sub.bottom
            margin-top: 24
            height: 16

            UIWidget
              id: z1
              anchors.left: parent.left
              anchors.top: parent.top
              anchors.bottom: parent.bottom
              background-color: #4a4a4a
              phantom: true

            UIWidget
              id: z2
              anchors.left: z1.right
              anchors.top: parent.top
              anchors.bottom: parent.bottom
              margin-left: 1
              background-color: #6c6c6c
              phantom: true

            UIWidget
              id: z3
              anchors.left: z2.right
              anchors.top: parent.top
              anchors.bottom: parent.bottom
              margin-left: 1
              background-color: #3d6b38
              phantom: true

            UIWidget
              id: z4
              anchors.left: z3.right
              anchors.top: parent.top
              anchors.bottom: parent.bottom
              margin-left: 1
              background-color: #34567e
              phantom: true

            UIWidget
              id: z5
              anchors.left: z4.right
              anchors.top: parent.top
              anchors.right: parent.right
              anchors.bottom: parent.bottom
              margin-left: 1
              background-color: #b8964a
              phantom: true

            UIWidget
              id: needle
              anchors.left: parent.left
              anchors.top: parent.top
              anchors.bottom: parent.bottom
              margin-top: -4
              margin-bottom: -4
              width: 3
              background-color: #ffffff
              phantom: true
              visible: false

          UIWidget
            id: legend
            anchors.left: meter.left
            anchors.right: meter.right
            anchors.top: meter.bottom
            margin-top: 3
            height: 12

            Label
              id: l1
              anchors.left: parent.left
              anchors.top: parent.top
              text-align: center
              font: Verdana-10px-antialiased
              color: #8c8c8c
              !text: tr('Weak')

            Label
              id: l2
              anchors.left: l1.right
              anchors.top: parent.top
              text-align: center
              font: Verdana-10px-antialiased
              color: #8c8c8c
              !text: tr('Fair')

            Label
              id: l3
              anchors.left: l2.right
              anchors.top: parent.top
              text-align: center
              font: Verdana-10px-antialiased
              color: #7fd36a
              !text: tr('Good')

            Label
              id: l4
              anchors.left: l3.right
              anchors.top: parent.top
              anchors.right: parent.right
              text-align: center
              font: Verdana-10px-antialiased
              color: #6fb2ff
              !text: tr('Excel.')

          ForgeDim
            id: meterMin
            anchors.left: meter.left
            anchors.top: legend.bottom
            margin-top: 2
            text-auto-resize: true
            font: Verdana-10px-antialiased

          ForgeDim
            id: meterMax
            anchors.right: meter.right
            anchors.top: legend.bottom
            margin-top: 2
            text-auto-resize: true
            font: Verdana-10px-antialiased
            color: #e2c46a

        ForgeText
          id: hint
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: costBar.top
          margin-bottom: 6
          height: 28
          text-wrap: true
          color: #a8a8a8

        ForgeInset
          id: costBar
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          height: 32

          ForgeDim
            id: costKey
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            text-auto-resize: true
            !text: tr('Cost:')

          UIWidget
            id: costXpIcon
            anchors.left: costKey.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            size: 14 14
            image-source: /game_raritybonus/images/forge/ui/rarity_xp

          ForgeText
            id: costXp
            anchors.left: costXpIcon.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 4
            text-auto-resize: true

          UIWidget
            id: costGoldIcon
            anchors.left: costXp.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 12
            size: 14 14
            image-source: /images/game/cyclopedia/icons/icon-goldcoin

          ForgeText
            id: costGold
            anchors.left: costGoldIcon.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 4
            text-auto-resize: true
            color: #e2c46a

          ForgeButton
            id: rollButton
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 5
            size: 120 22
            @onClick: modules.game_raritybonus.forgeRoll()

          ForgeButton
            id: skipButton
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 5
            size: 80 22
            !text: tr('Skip')
            visible: false
            @onClick: modules.game_raritybonus.forgeSkip()

      // ---------------------------------------------------- Upgrade
      UIWidget
        id: upPage
        anchors.top: head.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        visible: false

        UIWidget
          id: pair
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 18
          size: 160 52

          ForgeSlot
            id: fromBox
            anchors.left: parent.left
            anchors.top: parent.top
            size: 52 52
            change-cursor-image: false

          UIWidget
            id: arrow
            anchors.centerIn: parent
            size: 24 24
            image-source: /game_raritybonus/images/forge/arrow
            image-color: #a8a8a8
            phantom: true

          ForgeSlot
            id: toBox
            anchors.right: parent.right
            anchors.top: parent.top
            size: 52 52
            change-cursor-image: false

        Label
          id: path
          anchors.top: pair.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 10
          text-auto-resize: true
          font: Verdana Bold-11px

        Label
          id: chance
          anchors.top: path.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          text-auto-resize: true
          font: Verdana Bold-11px
          color: #e6e6e6

        ForgeInset
          id: forgeBar
          anchors.top: chance.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin: 16 40 0 40
          height: 14
          visible: false

          UIWidget
            id: fill
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            margin: 1
            width: 0
            background-color: #c9a24a

        Label
          id: forgePct
          anchors.top: forgeBar.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          text-auto-resize: true
          font: verdana-11px-antialised
          color: #e2c46a
          visible: false

        ForgeText
          id: explain
          anchors.top: chance.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin: 16 10 0 10
          height: 60
          text-wrap: true
          color: #a8a8a8

        ForgeDim
          id: maxText
          anchors.centerIn: parent
          width: 320
          height: 50
          text-align: center
          text-wrap: true
          visible: false

        ForgeInset
          id: upCostBar
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          height: 32

          ForgeDim
            id: upCostKey
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            text-auto-resize: true
            !text: tr('Cost:')

          UIWidget
            id: upGoldIcon
            anchors.left: upCostKey.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            size: 14 14
            image-source: /images/game/cyclopedia/icons/icon-goldcoin

          ForgeText
            id: upGold
            anchors.left: upGoldIcon.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 4
            text-auto-resize: true
            color: #e2c46a

          UIWidget
            id: upXpIcon
            anchors.left: upGold.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 12
            size: 14 14
            image-source: /game_raritybonus/images/forge/ui/rarity_xp

          ForgeText
            id: upXp
            anchors.left: upXpIcon.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 4
            text-auto-resize: true

          ForgeButton
            id: upButton
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 5
            size: 110 22
            @onClick: modules.game_raritybonus.forgeUpgrade()

        // the result, over the page, as Tibia's forge shows it
        ForgePanel
          id: result
          anchors.fill: parent
          visible: false

          Label
            id: title
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 16
            text-auto-resize: true
            font: Verdana Bold-13px

          UIWidget
            id: glow
            anchors.centerIn: box
            size: 120 120
            image-source: /game_raritybonus/images/forge/glow
            opacity: 0.6
            phantom: true

          ForgeSlot
            id: box
            anchors.top: title.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 12
            size: 52 52
            change-cursor-image: false

          Label
            id: grade
            anchors.top: box.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 8
            text-auto-resize: true
            font: Verdana Bold-11px

          ForgeText
            id: text
            anchors.top: grade.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin: 8 20 0 20
            height: 32
            text-align: center
            text-wrap: true

          UIWidget
            id: lines
            anchors.top: text.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 4
            width: 320
            height: 90
            layout:
              type: verticalBox
              align-center: true

          ForgeButton
            id: okButton
            anchors.bottom: parent.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-bottom: 10
            size: 80 22
            text: OK
            @onClick: modules.game_raritybonus.forgeCloseResult()

      // ---------------------------------------------------- My bonuses
      UIWidget
        id: totalsPage
        anchors.fill: parent
        visible: false

        ForgeDim
          id: hName
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 4
          text-auto-resize: true
          font: Verdana-10px-antialiased
          !text: tr('Bonus')

        ForgeDim
          id: hCap
          anchors.top: parent.top
          anchors.right: parent.right
          margin-right: 14
          width: 70
          text-align: right
          font: Verdana-10px-antialiased
          !text: tr('Limit')

        ForgeDim
          id: hTotal
          anchors.top: parent.top
          anchors.right: hCap.left
          width: 80
          text-align: right
          font: Verdana-10px-antialiased
          !text: tr('Total')

        UIWidget
          id: hRule
          anchors.top: hName.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 4
          height: 1
          background-color: #3c3c3c
          phantom: true

        ScrollablePanel
          id: list
          anchors.top: hRule.bottom
          anchors.left: parent.left
          anchors.right: listScroll.left
          anchors.bottom: note.top
          margin-bottom: 4
          vertical-scrollbar: listScroll
          layout:
            type: verticalBox

        VerticalScrollBar
          id: listScroll
          anchors.top: hRule.bottom
          anchors.bottom: note.top
          margin-bottom: 4
          anchors.right: parent.right
          width: 8
          step: 21
          pixels-scroll: true

        ForgeDim
          id: note
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          height: 28
          text-wrap: true
          font: Verdana-10px-antialiased
          !text: tr('Gold: at the limit (more of it adds nothing). Hover a line to see which items give it. Only worn items count.')

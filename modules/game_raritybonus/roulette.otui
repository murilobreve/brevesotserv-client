RouletteFrame < UIWidget
  size: 44 44
  image-source: /game_raritymarket/images/frames
  image-clip: 0 0 34 34
  phantom: true

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: parent
    virtual: true
    phantom: true

// a line of the reel: one bonus the slot could land on
RouletteLine < UIWidget
  height: 34
  phantom: true

  Label
    id: text
    anchors.fill: parent
    text-align: center
    font: Verdana Bold-13px
    color: #ab9fc6
    phantom: true

// a slot's result under the reel
RouletteResult < UIWidget
  height: 26
  background-color: #0f0a19f0
  border-width: 1
  border-color: #4a3670
  phantom: true

  // the locked bonus: it doesn't spin
  UIWidget
    id: lock
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    size: 12 12
    image-source: /game_raritybonus/images/lock_on
    visible: false
    phantom: true

  Label
    id: slot
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    width: 70
    font: verdana-11px-monochrome
    color: #9789b3
    phantom: true

  Label
    id: text
    anchors.left: slot.right
    anchors.right: info.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    text-align: center
    font: Verdana Bold-11px
    color: #655780
    phantom: true

  // (i): what the bonus does, on hover
  BonusInfo
    id: info
    anchors.right: odds.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    visible: false

  // after the roll: the bonus's range on the item and the odds of this
  // value or better
  Label
    id: odds
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 150
    text-align: right
    font: verdana-11px-monochrome
    color: #9789b3
    phantom: true

// raising the grade: the chance, a bar filled to it in the new grade's colour
UpgradeChance < UIWidget
  height: 26
  background-color: #0f0a19f0
  border-width: 1
  border-color: #4a3670
  phantom: true

  Label
    id: label
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    width: 70
    font: verdana-11px-monochrome
    color: #9789b3
    phantom: true

  UIWidget
    id: bar
    anchors.left: label.right
    anchors.right: percent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    height: 12
    background-color: #2a2140
    border-width: 1
    border-color: #4a3670
    phantom: true

    UIWidget
      id: fill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin: 1
      width: 0
      phantom: true

  Label
    id: percent
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 170
    text-align: right
    font: Verdana Bold-11px
    phantom: true

MythosWindow
  id: rarityRouletteWindow
  !text: tr('Rarity Roulette')
  size: 600 480
  @onEscape: modules.game_raritybonus.closeRoulette()

  RouletteFrame
    id: frame
    anchors.top: parent.top
    anchors.left: parent.left

  Label
    id: name
    anchors.top: frame.top
    anchors.left: frame.right
    anchors.right: parent.right
    margin-left: 10
    margin-top: 6
    height: 16
    font: Verdana Bold-13px

  Label
    id: subtitle
    anchors.top: name.bottom
    anchors.left: name.left
    anchors.right: parent.right
    margin-top: 3
    height: 14
    font: verdana-11px-monochrome
    color: #ab9fc6

  // the reel: three lines, the slot's result stops on the middle one
  UIWidget
    id: reel
    anchors.top: frame.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    size: 400 106
    background-color: #0f0a19f0
    border-width: 1
    border-color: #5a4384
    clipping: true

    UIWidget
      id: strip
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      phantom: true
      layout:
        type: verticalBox

  // the lines above and below the middle one, shaded
  UIWidget
    id: shadeTop
    anchors.top: reel.top
    anchors.left: reel.left
    anchors.right: reel.right
    margin: 1
    height: 35
    background-color: #000000a0
    phantom: true

  UIWidget
    id: shadeBottom
    anchors.bottom: reel.bottom
    anchors.left: reel.left
    anchors.right: reel.right
    margin: 1
    height: 35
    background-color: #000000a0
    phantom: true

  // the gold frame of the middle line
  UIWidget
    id: reelFocus
    anchors.verticalCenter: reel.verticalCenter
    anchors.left: reel.left
    anchors.right: reel.right
    margin-left: -6
    margin-right: -6
    height: 36
    border-width: 2
    border-color: #e2a443
    phantom: true

  Panel
    id: results
    anchors.top: reel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 14
    height: 145
    layout:
      type: verticalBox
      spacing: 3

  Label
    id: status
    anchors.top: results.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 34
    text-align: center
    text-wrap: true
    font: Verdana Bold-11px
    color: #e2a443

  MythosSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Label
    id: xp
    anchors.left: parent.left
    anchors.verticalCenter: closeButton.verticalCenter
    text-auto-resize: true
    color: #e2a443

  MythosButton
    id: buyXpButton
    anchors.left: xp.right
    anchors.verticalCenter: closeButton.verticalCenter
    margin-left: 8
    size: 130 22
    !text: tr('Buy Rarity XP')
    !tooltip: tr('Buy Rarity XP here, with Mythos Coins or Hunt Points.')
    @onClick: modules.game_raritybonus.buyRarityXp()

  MythosPrimaryButton
    id: againButton
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    size: 250 22
    @onClick: modules.game_raritybonus.spinAgain()

  MythosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 70 22
    @onClick: modules.game_raritybonus.closeRoulette()

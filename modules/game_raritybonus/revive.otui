// a rare monster rising from its corpse: rings and a glow in the tier's
// colour, drawn over the tile (raritybonus.lua)
ReviveBox < UIWidget
  phantom: true
  focusable: false

ReviveRing < UIWidget
  anchors.centerIn: parent
  image-source: /game_raritybonus/images/revive_ring
  image-smooth: true
  phantom: true

ReviveGlow < ReviveRing
  image-source: /game_raritybonus/images/revive_glow

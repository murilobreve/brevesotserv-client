BonusFrame < UIWidget
  size: 36 36
  image-source: /game_raritymarket/images/frames
  image-clip: 0 0 34 34
  phantom: true

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: parent
    virtual: true
    phantom: true

// one rarity item: frame, name, who found it, then its bonuses
BonusItemRow < BrevesRow
  focusable: false
  padding: 3

  BonusFrame
    id: frame
    anchors.left: parent.left
    anchors.top: parent.top

  // rolls the whole item again: how many bonuses, which ones, their values
  BonusActionButton
    id: rerollItemButton
    anchors.top: parent.top
    anchors.right: parent.right
    width: 136
    icon: /game_raritybonus/images/reroll

  // raises the item one grade: gold and Rarity XP, with a chance to fail
  BonusActionButton
    id: upgradeItemButton
    anchors.top: rerollItemButton.bottom
    anchors.right: parent.right
    margin-top: 3
    width: 136
    icon: /game_raritybonus/images/improve

  // the upgrade's price, under its button
  Label
    id: upgradeCost
    anchors.top: upgradeItemButton.bottom
    anchors.left: upgradeItemButton.left
    anchors.right: upgradeItemButton.right
    margin-top: 1
    height: 12
    text-align: center
    font: verdana-11px-monochrome
    color: #c9b88a
    phantom: true
    visible: false

  Label
    id: name
    anchors.top: parent.top
    anchors.left: frame.right
    anchors.right: rerollItemButton.left
    margin-left: 8
    margin-right: 6
    margin-top: 1
    height: 14
    phantom: true

  // found by the player (its bonuses +finderPercent on them) or not
  Label
    id: finder
    anchors.top: name.bottom
    anchors.left: name.left
    margin-top: 1
    height: 14
    text-auto-resize: true
    font: verdana-11px-monochrome
    phantom: true

  BonusInfo
    id: finderInfo
    anchors.left: finder.right
    anchors.verticalCenter: finder.verticalCenter
    margin-left: 5

  Panel
    id: bonuses
    anchors.top: finder.bottom
    anchors.left: name.left
    anchors.right: rerollItemButton.left
    margin-top: 3
    margin-right: 8
    layout:
      type: verticalBox
      spacing: 2

// reroll / change button: Store look, an icon and the price
BonusActionButton < MythosButton
  size: 66 18
  icon-align: left
  icon-offset: 4 0
  text-offset: 8 0
  $pressed:
    text-offset: 9 1
  $disabled:
    opacity: 0.7

// "Keep" on a bonus: a padlock and a word, gold once it is kept
BonusKeepButton < UIButton
  size: 74 16
  font: verdana-11px-monochrome
  color: #b3a7cc
  text-align: left
  text-offset: 21 0
  icon: /game_raritybonus/images/lock_off
  icon-align: left
  icon-offset: 5 0
  background-color: #1a1229
  border-width: 1
  border-color: #5a4384
  cursor: pointer
  $hover !on:
    border-color: #e0c060
    color: #f0cf6a
  $on:
    icon: /game_raritybonus/images/lock_on
    background-color: #e0c06033
    border-color: #e0c060
    color: #f0cf6a

// (i) next to a bonus: hovering it shows what the bonus does (the roulette
// uses it too)
BonusInfo < UIWidget
  size: 14 14
  image-source: /game_raritybonus/images/info
  opacity: 0.8
  $hover:
    opacity: 1

// one bonus of an item; "Keep" holds it, with its value, on the next reroll
BonusLine < Panel
  height: 18

  Label
    id: text
    anchors.left: parent.left
    anchors.right: info.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    margin-right: 4
    font: verdana-11px-monochrome
    color: #7fd35a

  // (i): what the bonus does, on hover
  BonusInfo
    id: info
    anchors.right: keep.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    visible: false

  BonusKeepButton
    id: keep
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 1
    visible: false

BonusItemRowEven < BonusItemRow
  background-color: #ffffff07

// one bonus: its total (and cap) on the right, the items it comes from below
BonusTotalRow < BrevesRow
  focusable: false
  padding: 3 6 3 6

  Label
    id: label
    anchors.top: parent.top
    anchors.left: parent.left
    height: 14
    text-auto-resize: true
    color: #e6e0f2
    phantom: true

  // (i): what the bonus does, on hover
  BonusInfo
    id: info
    anchors.left: label.right
    anchors.verticalCenter: label.verticalCenter
    margin-left: 5
    visible: false

  Label
    id: total
    anchors.top: parent.top
    anchors.right: parent.right
    width: 140
    height: 14
    text-align: right
    color: #7fd35a
    phantom: true

  // how far the total is from the bonus's limit (MAX, above on the right): 0
  // on the left, the total now on the right, or a green check once it is full
  // (bonuses with a limit only)
  UIWidget
    id: meter
    anchors.top: label.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 12
    phantom: true

    Label
      id: low
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 28
      font: verdana-10px-rounded
      color: #9789b3
      phantom: true

    // what the player has now, in white; once the bar is full, the green
    // check takes its place (MAX above says the value)
    Label
      id: high
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 40
      text-align: center
      font: verdana-11px-rounded
      color: #ffffff
      phantom: true

    UIWidget
      id: check
      anchors.centerIn: high
      size: 12 12
      image-source: /game_raritybonus/images/check
      phantom: true
      visible: false

    UIWidget
      id: bar
      anchors.left: low.right
      anchors.right: high.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      height: 8
      background-color: #1a1328
      border-width: 1
      border-color: #4a3670
      phantom: true

      UIWidget
        id: fill
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin: 1
        width: 0
        background-color: #63c08a
        phantom: true

  Label
    id: sources
    anchors.top: meter.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    font: verdana-11px-monochrome
    color: #ab9fc6
    phantom: true

// a column title over the items and its (i), centred in its box
RarityColumnTitle < UIWidget
  height: 20
  phantom: true

  Label
    id: title
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-left: -9
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #b4afc3
    phantom: true

  BonusInfo
    id: info
    anchors.left: title.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

BonusTotalRowEven < BonusTotalRow
  background-color: #ffffff07

MythosWindow
  id: rarityBonusWindow
  !text: tr('Rarity Bonuses')
  size: 900 560
  @onEscape: modules.game_raritybonus.hide()

  Label
    id: xpLabel
    anchors.top: parent.top
    anchors.left: parent.left
    height: 18
    text-auto-resize: true
    color: #e2a443

  // shortcut to the Store's Rarity category (Rarity XP packs)
  MythosButton
    id: buyXpButton
    anchors.verticalCenter: xpLabel.verticalCenter
    anchors.left: xpLabel.right
    margin-left: 10
    size: 130 20
    !text: tr('Buy Rarity XP')
    !tooltip: tr('Buy Rarity XP here, with Mythos Coins or Hunt Points.')
    @onClick: modules.game_raritybonus.buyRarityXp()

  // the gold in the bank, with a coin (the gold prices are paid from the
  // backpack and the bank)
  Label
    id: bankLabel
    anchors.verticalCenter: buyXpButton.verticalCenter
    anchors.left: buyXpButton.right
    margin-left: 16
    height: 18
    text-auto-resize: true
    color: #e2a443
    !text: tr('Bank')

  BrevesValueBox
    id: bankBox
    anchors.verticalCenter: buyXpButton.verticalCenter
    anchors.left: bankLabel.right
    margin-left: 6
    width: 120

  Label
    id: status
    anchors.verticalCenter: buyXpButton.verticalCenter
    anchors.left: bankBox.right
    anchors.right: parent.right
    margin-left: 16
    height: 26
    text-align: right
    text-wrap: true
    font: verdana-11px-antialised
    color: #7fd35a

  BrevesSection
    id: itemsSection
    anchors.top: xpLabel.bottom
    anchors.left: parent.left
    anchors.bottom: bottomSep.top
    margin-top: 6
    margin-bottom: 8
    width: 500
    !text: tr('Rarity items you wear')

    // the columns of the rows below, each with its (i): the bonuses, Keep,
    // Reroll and Raise (boxes over those columns, see BonusItemRow)
    BrevesHeader
      id: itemsHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: itemsScroll.left

      RarityColumnTitle
        id: bonusesTitle
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 49
        width: 62

      RarityColumnTitle
        id: keepTitle
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 149
        width: 74

      RarityColumnTitle
        id: raiseTitle
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 5
        width: 64

      RarityColumnTitle
        id: rerollTitle
        anchors.right: raiseTitle.left
        anchors.top: parent.top
        width: 72

    BrevesList
      id: itemsList
      anchors.top: itemsHeader.bottom
      anchors.left: parent.left
      anchors.right: itemsScroll.left
      anchors.bottom: parent.bottom
      vertical-scrollbar: itemsScroll

    // under the header (which ends where the scroll bar starts)
    MythosScrollBar
      id: itemsScroll
      anchors.top: parent.top
      margin-top: 20
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 30
      pixel-scroll: true

    BrevesNote
      id: itemsEmpty
      anchors.top: itemsList.top
      anchors.left: itemsList.left
      anchors.right: itemsList.right
      margin: 10
      text-align: center
      !text: tr('You are not wearing any rarity item. Monsters drop them, and the task shop sells scrolls that give an item a rarity.')
      visible: false

  BrevesSection
    id: totalsSection
    anchors.top: itemsSection.top
    anchors.left: itemsSection.right
    anchors.right: parent.right
    anchors.bottom: bottomSep.top
    margin-left: 8
    margin-bottom: 8
    !text: tr('Total of each bonus')

    // (i) next to the title: MAX, the bar and the check (placed in Lua, after
    // the centred title)
    BonusInfo
      id: titleInfo
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: -22

    BrevesList
      id: totalsList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: totalsScroll.left
      anchors.bottom: parent.bottom
      vertical-scrollbar: totalsScroll

    MythosScrollBar
      id: totalsScroll
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 30
      pixel-scroll: true

  MythosSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 6

  MythosButton
    id: refreshButton
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    size: 70 22
    !text: tr('Refresh')
    @onClick: modules.game_raritybonus.request()

  MythosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 60 22
    !text: tr('Close')
    @onClick: modules.game_raritybonus.hide()

// one Rarity XP pack of the shop below: the amount, how much cheaper it is
// than the smallest pack, and the price to click
RarityXpPack < BrevesRow
  height: 28
  focusable: false

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    size: 16 16
    image-source: /game_raritybonus/images/reroll
    phantom: true

  Label
    id: amount
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-auto-resize: true
    font: Verdana Bold-11px
    color: #e6e0f2
    phantom: true

  Label
    id: note
    anchors.left: amount.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #7fd35a
    phantom: true

  MythosButton
    id: buy
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    size: 120 20

// Rarity XP right in the window (server: xpShop in bonus_window.lua): the
// Store's packs for Mythos Coins and the task shop's for Hunt Points
RarityXpShop < MythosWindow
  id: rarityXpShop
  !text: tr('Buy Rarity XP')
  size: 420 300
  @onEscape: self:hide()

  Label
    id: balance
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    color: #e2a443

  Label
    id: coinsTitle
    anchors.top: balance.bottom
    anchors.left: parent.left
    margin-top: 10
    text-auto-resize: true
    font: Verdana Bold-11px
    color: #f1d399
    !text: tr('With Mythos Coins')

  Label
    id: coinsHave
    anchors.right: parent.right
    anchors.verticalCenter: coinsTitle.verticalCenter
    text-auto-resize: true
    color: #ab9fc6

  BrevesList
    id: coinsList
    anchors.top: coinsTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 90

  Label
    id: pointsTitle
    anchors.top: coinsList.bottom
    anchors.left: parent.left
    margin-top: 10
    text-auto-resize: true
    font: Verdana Bold-11px
    color: #f1d399
    !text: tr('With Hunt Points')

  Label
    id: pointsHave
    anchors.right: parent.right
    anchors.verticalCenter: pointsTitle.verticalCenter
    text-auto-resize: true
    color: #ab9fc6

  BrevesList
    id: pointsList
    anchors.top: pointsTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 60

  Label
    id: status
    anchors.top: pointsList.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 16
    text-align: center
    color: #7fd35a

  // no coins: the site sells them
  MythosButton
    id: siteButton
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    size: 180 22
    !text: tr('Get Mythos Coins on the site')

  MythosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 70 22
    !text: tr('Close')
    @onClick: self:getParent():hide()

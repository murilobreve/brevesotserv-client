ScreenMessagesWindow < MythosWindow
  !text: tr('Interface')
  size: 300 326
  @onEscape: modules.game_textmessage.hidePositionWindow()

  Label
    id: section
    !text: tr('Screen Messages')
    anchors.top: parent.top
    anchors.left: parent.left
    font: verdana-11px-rounded
    color: #f3dcae
    text-auto-resize: true

  Label
    id: help
    !text: tr('Where the look, loot and warning messages show. Hotkey messages stay in the middle.')
    anchors.top: prev.bottom
    margin-top: 4
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text-auto-resize: true

  Label
    id: horizontalLabel
    !text: tr('Left / right')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 10

  MythosHSlider
    id: horizontal
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    minimum: 0
    maximum: 100
    step: 5

  Label
    id: verticalLabel
    !text: tr('Top / bottom')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 10

  MythosHSlider
    id: vertical
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    minimum: 0
    maximum: 100
    step: 5

  // the same setting as Options > Graphics > Map zoom
  Label
    id: zoomSection
    !text: tr('Map zoom')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 14
    font: verdana-11px-rounded
    color: #f3dcae
    text-auto-resize: true

  MythosComboBox
    id: mapZoom
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    mouse-scroll: false

  // how a look or the mouse over an item shows it (game_itemcard)
  Label
    id: itemCardsSection
    !text: tr('Item cards')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 14
    font: verdana-11px-rounded
    color: #f3dcae
    text-auto-resize: true

  MythosComboBox
    id: itemCards
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    mouse-scroll: false

  MythosButton
    id: closeButton
    !text: tr('Close')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom

  MythosButton
    id: centerButton
    !text: tr('Middle')
    width: 64
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    margin-right: 6

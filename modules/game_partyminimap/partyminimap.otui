// one party member on the minimap: just their outfit, small, with no frame.
// Name, vocation, health and floor are in the tooltip. The dot is for a
// server that sends no outfit yet.
PartyMinimapMark < UICreature
  size: 14 14
  creature-size: 14
  focusable: false

PartyMinimapDot < UIWidget
  size: 6 6
  border-width: 1
  border-color: #000000
  background-color: #5fdc6a
  focusable: false

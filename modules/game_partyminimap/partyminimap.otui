// one party member on the minimap: a small dot in the colour of their
// vocation; the ring turns white when their health is low. Name, vocation,
// health and floor are in the tooltip.
PartyMinimapMark < UIWidget
  size: 6 6
  border-width: 1
  border-color: #000000
  background-color: #ffffff
  focusable: false

PartyMinimapDot < UIWidget
  size: 6 6
  border-width: 1
  border-color: #000000
  background-color: #5fdc6a
  focusable: false

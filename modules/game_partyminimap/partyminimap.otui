// one party member on the minimap: their outfit in a small frame coloured
// by vocation, with a health bar under it. The frame keeps them apart from
// the map's own colours; the old dot (PartyMinimapDot) is for a server that
// sends no outfit yet.
PartyMinimapMark < UIWidget
  size: 24 28
  focusable: false
  phantom: false

  UIWidget
    id: frame
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 24 24
    background-color: #101010c0
    border-width: 2
    border-color: #ffffff
    phantom: true

  UICreature
    id: creature
    anchors.centerIn: frame
    size: 22 22
    creature-size: 22
    phantom: true

  UIWidget
    id: healthBack
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    size: 22 4
    background-color: #000000
    border-width: 1
    border-color: #000000
    phantom: true

  UIWidget
    id: health
    anchors.left: healthBack.left
    anchors.top: healthBack.top
    margin-left: 1
    margin-top: 1
    size: 20 2
    background-color: #5fdc6a
    phantom: true

PartyMinimapDot < UIWidget
  size: 9 9
  border-width: 2
  border-color: #ffffff
  background-color: #5fdc6a
  focusable: false
  clipping: true

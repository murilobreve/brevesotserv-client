// one spell in the left list
GrimorioSpellRow < BrevesRow
  height: 38
  padding: 3 6

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    color: #ffffff
    phantom: true

  Label
    id: words
    anchors.top: name.bottom
    anchors.left: parent.left
    width: 90
    height: 14
    font: verdana-11px-monochrome
    color: #8a8a8a
    phantom: true

  Label
    id: rank
    anchors.top: name.bottom
    anchors.left: words.right
    anchors.right: parent.right
    height: 14
    text-align: right
    font: verdana-11px-monochrome
    color: #6a6a6a
    phantom: true

// one rank line inside a path card: a square that fills when the rank is learned
GrimorioRankLine < UIWidget
  height: 30
  phantom: true

  UIWidget
    id: dot
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 3
    size: 8 8
    border-width: 1
    border-color: #000000
    background-color: #00000060
    phantom: true

  Label
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 14
    text-wrap: true
    font: verdana-11px-monochrome
    color: #6a6a6a
    phantom: true

// path A or B of the selected spell
GrimorioPathCard < BrevesSection
  padding: 24 10 10 10

  Label
    id: summary
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 30
    text-wrap: true
    color: #dfdfdf

  GrimorioRankLine
    id: rank1
    anchors.top: summary.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10

  GrimorioRankLine
    id: rank2
    anchors.top: rank1.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  GrimorioRankLine
    id: rank3
    anchors.top: rank2.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  Label
    id: note
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: action.top
    margin-bottom: 6
    height: 28
    text-wrap: true
    font: verdana-11px-monochrome
    color: #909090

  Button
    id: action
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24

// a seal in the seals view
GrimorioSealCard < BrevesSection
  height: 92
  padding: 24 10 8 10

  Label
    id: desc
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: action.left
    anchors.bottom: parent.bottom
    margin-right: 10
    text-wrap: true
    color: #dfdfdf

  Button
    id: action
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 150 24

MainWindow
  id: grimorioWindow
  size: 740 540
  @onEscape: modules.game_grimorio.hide()

  Label
    id: points
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: resetButton.left
    height: 18
    color: #ffffff

  Label
    id: pointsNote
    anchors.top: points.bottom
    anchors.left: parent.left
    anchors.right: resetButton.left
    height: 16
    font: verdana-11px-monochrome
    color: #909090

  Button
    id: resetButton
    anchors.top: parent.top
    anchors.right: parent.right
    size: 150 24
    @onClick: modules.game_grimorio.askReset()

  HorizontalSeparator
    id: topSep
    anchors.top: pointsNote.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  BrevesList
    id: spellList
    anchors.top: topSep.bottom
    anchors.left: parent.left
    anchors.bottom: message.top
    margin-top: 8
    margin-bottom: 6
    width: 196

  Panel
    id: detail
    anchors.top: topSep.bottom
    anchors.left: spellList.right
    anchors.right: parent.right
    anchors.bottom: message.top
    margin-top: 8
    margin-left: 10
    margin-bottom: 6

    Label
      id: title
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      font: verdana-11px-rounded
      color: #ffffff

    Label
      id: subtitle
      anchors.top: title.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 16
      font: verdana-11px-monochrome
      color: #909090

    Panel
      id: paths
      anchors.top: subtitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8

      GrimorioPathCard
        id: pathA
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 252

      GrimorioPathCard
        id: pathB
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        width: 252

    Panel
      id: seals
      anchors.fill: paths
      visible: false
      layout:
        type: verticalBox
        spacing: 8

  Label
    id: message
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomSep.top
    margin-bottom: 6
    height: 16
    text-align: center

  HorizontalSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Label
    id: footer
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    font: verdana-11px-monochrome
    color: #909090

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 60 22
    !text: tr('Fechar')
    @onClick: modules.game_grimorio.hide()

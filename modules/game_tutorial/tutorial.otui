// The tour window: small, at the top of the game screen, never modal, so the
// window each step opens stays visible and usable next to it.
MythosTutorialWindow < MythosWindow
  id: mythosTutorialWindow
  !text: tr('Mythos tour')
  size: 430 236
  @onEscape: modules.game_tutorial.stop()

  Label
    id: counter
    anchors.top: parent.top
    anchors.right: parent.right
    font: verdana-11px-rounded
    color: #9789b3
    text-auto-resize: true

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: counter.left
    font: verdana-11px-rounded
    color: #ffd77a
    text-auto-resize: true

  UIWidget
    id: progressBack
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 3
    background-color: #2a2140

  UIWidget
    id: progress
    anchors.top: progressBack.top
    anchors.left: progressBack.left
    height: 3
    width: 10
    background-color: #d9a520

  Label
    id: text
    anchors.top: progressBack.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #e6e0f2

  UIButton
    id: skipButton
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 6
    !text: tr('Skip the tour')
    font: verdana-11px-rounded
    color: #9789b3
    text-auto-resize: true
    @onClick: modules.game_tutorial.stop()
    $hover:
      color: #e6e0f2

  MythosKitGoldButton
    id: nextButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 120 28
    !text: tr('Next')
    @onClick: modules.game_tutorial.next()

  MythosKitButton
    id: backButton
    anchors.right: nextButton.left
    anchors.bottom: parent.bottom
    margin-right: 8
    size: 100 28
    !text: tr('Back')
    @onClick: modules.game_tutorial.back()

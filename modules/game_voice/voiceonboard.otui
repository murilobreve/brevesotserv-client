// Mythos Voz: shown once, the first time the server offers voice. It says the
// microphone opens by itself, asks for headphones and links the rules. With
// push-to-talk chosen it also takes the talk key (a free one is offered:
// Insert on a new profile; in the browser the mouse side button is an option
// too); with voice activation, the default, those rows hide and the window
// is shorter. The PT-BR texts fit the 348 px of content.

VoiceOnboardWindow < MythosWindow
  !text: tr('Mythos Voice')
  size: 380 390
  @onEscape: modules.game_voice.VoiceSettings.closeOnboarding(false)

  Label
    id: intro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    font: verdana-11px-antialised
    color: #dfdfdf
    text-wrap: true
    text-auto-resize: true
    !text: tr('Talk while you play: the microphone opens by itself when you speak. Not to be heard, mute the microphone or leave the room.')

  Label
    id: headset
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    font: verdana-11px-antialised
    color: #c0c0c0
    text-wrap: true
    text-auto-resize: true
    !text: tr('Use headphones: speakers make an echo for the others.')

  Label
    id: rules
    anchors.top: headset.bottom
    anchors.left: parent.left
    anchors.right: rulesButton.left
    margin-top: 8
    margin-right: 6
    font: verdana-11px-antialised
    color: #c0c0c0
    text-wrap: true
    text-auto-resize: true
    !text: tr('Be respectful: insults, harassment and noise are punished.')

  VoiceSmallButton
    id: rulesButton
    anchors.top: headset.bottom
    anchors.right: parent.right
    margin-top: 8
    !text: tr('Rules')
    @onClick: modules.game_voice.VoiceSettings.openRules()

  Label
    id: keyLabel
    anchors.top: rules.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 14
    font: verdana-11px-antialised
    color: #dfdfdf
    text-wrap: true
    text-auto-resize: true
    !text: tr('If you would rather hold a key to talk, click the box and press it:')

  UIWidget
    id: keyBox
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    size: 160 24
    image-source: /images/ui/textedit
    image-border: 1
    font: Verdana Bold-11px
    color: #dfdfdf
    text-align: center
    focusable: true
    change-cursor-image: true
    cursor: pointer

    $focus:
      image-source: /images/ui/textedit
      image-border: 1

  // the suggested key, until the player picks one
  Label
    id: keyHint
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    font: verdana-11px-antialised
    color: #909090
    text-align: center
    text-wrap: true
    text-auto-resize: true

  Label
    id: keyStatus
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    font: verdana-11px-antialised
    color: #f75f5f
    text-align: center
    text-wrap: true
    text-auto-resize: true

  // the browser only (voice_settings.lua shows it)
  QtCheckBox
    id: mouseCheck
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    font: verdana-11px-antialised
    color: #c0c0c0
    visible: false
    !text: tr('Also talk with the mouse side button (Mouse 4)')

  MythosPrimaryButton
    id: onButton
    !text: tr('Turn voice on')
    width: 110
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_voice.VoiceSettings.closeOnboarding(true)

  MythosButton
    id: laterButton
    !text: tr('Not now')
    anchors.right: onButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    @onClick: modules.game_voice.VoiceSettings.closeOnboarding(false)

// Ascensão: the web. The three paths of a vocation are its spines, from the
// centre out, with their five circles and the relic past each end; between
// two spines lie the small nodes, the notables and a keystone on the rim.
// The web is drawn by ascensao.lua (nodes and links are placed there, the
// player drags it and zooms with the wheel); the panel on the right tells
// about the chosen node and buys it. Built from the Breves window parts
// (50-breves.otui).

// a link between two nodes: a bar stretched and turned (ascensao.lua)
AscensaoLink < UIWidget
  image-source: /game_ascensao/images/teia/link
  phantom: true
  focusable: false

// a node: its own shape, tinted by its state; a circle or a relic shows the
// designer's art in `icon`
AscensaoNode < UIWidget
  focusable: false

  UIWidget
    id: icon
    anchors.centerIn: parent
    phantom: true
    visible: false

// a line of the totals on the right
AscensaoTotal < Label
  font: verdana-11px-antialised
  color: #d8cfbf
  height: 15
  phantom: true

AscensaoPreview < UIWidget
  size: 304 190
  image-source: /images/mythos/panel
  image-border: 4
  padding: 8
  phantom: true
  focusable: false

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 14
    font: verdana-11px-rounded
    color: #f3dcae
    phantom: true

  UIWidget
    id: movie
    anchors.top: title.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    size: 288 162
    image-fixed-ratio: true
    phantom: true

  // how to cast it (empty: no lines)
  Label
    id: use
    anchors.top: movie.bottom
    anchors.left: parent.left
    margin-top: 6
    color: #d8c89a
    height: 0
    phantom: true

MythosWindow
  id: ascensaoWindow
  size: 1010 690
  @onEscape: modules.game_ascensao.hide()

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: resetButton.left
    height: 18
    font: verdana-11px-rounded
    color: #f3dcae

  Label
    id: points
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    anchors.right: resetButton.left
    height: 16
    font: verdana-11px-antialised
    color: #d1ccd9

  MythosButton
    id: resetButton
    anchors.top: parent.top
    anchors.right: closeButton.left
    margin-right: 6
    size: 110 22
    text: Reset
    @onClick: modules.game_ascensao.askReset()

  MythosButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    size: 70 22
    text: Fechar
    @onClick: modules.game_ascensao.hide()

  // the chosen node and the totals of the web
  UIWidget
    id: side
    anchors.top: points.bottom
    anchors.right: parent.right
    anchors.bottom: message.top
    margin-top: 8
    margin-bottom: 4
    width: 268
    background-color: #120c1ecc
    border-width: 1
    border-color: #3a3346
    padding: 10

    Label
      id: kind
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 14
      font: verdana-11px-antialised
      color: #b296f5

    Label
      id: name
      anchors.top: kind.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      height: 18
      font: verdana-11px-rounded
      color: #f3dcae

    Label
      id: text
      anchors.top: name.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 14
      font: verdana-11px-antialised
      color: #d8cfbf

    // the spell a first circle teaches: its preview under the mouse
    Label
      id: skill
      anchors.top: text.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 14
      font: verdana-11px-antialised
      color: #9fd6ff
      visible: false

    MythosButton
      id: buy
      anchors.top: skill.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 26
      visible: false
      @onClick: modules.game_ascensao.buyChosen()

    Label
      id: why
      anchors.top: buy.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 14
      font: verdana-11px-antialised
      color: #b4afc3

    UIWidget
      id: rule
      anchors.top: why.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      height: 1
      background-color: #3a3346

    Label
      id: totalsTitle
      anchors.top: rule.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 14
      font: verdana-11px-rounded
      color: #f3dcae

    VerticalScrollBar
      id: totalsScroll
      anchors.top: totalsTitle.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      step: 15
      pixels-scroll: true

    ScrollablePanel
      id: totals
      anchors.top: totalsTitle.bottom
      anchors.left: parent.left
      anchors.right: totalsScroll.left
      anchors.bottom: parent.bottom
      margin-top: 4
      vertical-scrollbar: totalsScroll
      layout:
        type: verticalBox

  // the web: dragged with the mouse, zoomed with the wheel
  UIWidget
    id: canvas
    anchors.top: points.bottom
    anchors.left: parent.left
    anchors.right: side.left
    anchors.bottom: message.top
    margin-top: 8
    margin-right: 8
    margin-bottom: 4
    background-color: #0b0813
    border-width: 1
    border-color: #3a3346
    clipping: true
    focusable: false

    UIWidget
      id: holder
      anchors.top: parent.top
      anchors.left: parent.left
      phantom: true
      focusable: false

    Label
      id: hint
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-left: 8
      margin-bottom: 6
      height: 14
      font: verdana-11px-antialised
      color: #6f6782
      text-auto-resize: true
      phantom: true

    MythosButton
      id: centre
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 6
      margin-bottom: 6
      size: 80 20
      text: Centralizar
      @onClick: modules.game_ascensao.centre()

  Label
    id: message
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 16
    font: verdana-11px-antialised
    color: #b4afc3

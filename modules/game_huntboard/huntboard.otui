HuntTab < BrevesTab
  size: 140 24
  anchors.top: parent.top

PeriodTab < BrevesTab
  size: 110 24

// multiplier bar: dark track, coloured fill, value on top
MultBar < UIWidget
  size: 118 14
  background-color: #0f0a19
  border-width: 1
  border-color: #3e2d5e
  phantom: true

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 1
    width: 10
    phantom: true

  UIWidget
    id: mark
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 1
    background-color: #ffffff50
    phantom: true

  Label
    id: value
    anchors.fill: parent
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

// one column per element a player deals, in the Cyclopedia's order: the
// change in damage the monster takes (huntboard.lua fills them), under the
// element's icon in the list header (ElementHead)
ElementCell < Label
  width: 24
  text-align: center
  font: verdana-11px-monochrome
  phantom: true

ElementCells < Panel
  width: 168
  phantom: true
  layout:
    type: horizontalBox

  ElementCell
    id: physical
  ElementCell
    id: earth
  ElementCell
    id: fire
  ElementCell
    id: death
  ElementCell
    id: energy
  ElementCell
    id: holy
  ElementCell
    id: ice

ElementHeadCell < UIWidget
  width: 24
  border-color: #6b5a8e
  change-cursor-image: true
  cursor: pointer
  $hover:
    background-color: #ffffff12

  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 9 9
    phantom: true

ElementHead < Panel
  width: 168
  layout:
    type: horizontalBox

  ElementHeadCell
    id: physical
  ElementHeadCell
    id: earth
  ElementHeadCell
    id: fire
  ElementHeadCell
    id: death
  ElementHeadCell
    id: energy
  ElementHeadCell
    id: holy
  ElementHeadCell
    id: ice

RateRow < BrevesRow
  height: 46
  padding: 2

  Label
    id: rank
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 34
    text-align: center
    color: #9789b3
    phantom: true

  UICreature
    id: creature
    anchors.left: rank.right
    anchors.verticalCenter: parent.verticalCenter
    size: 42 42
    creature-size: 42
    phantom: true

  // to the monster's hunt (Hunts TP), the action this list is about;
  // hidden for a monster with no teleport
  MythosPrimaryButton
    id: tp
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    size: 54 24

  // a column per number, each one off the row's right edge only (anchors
  // between siblings that wait on each other crash the browser client); the
  // list header's titles sit 4 px further (the list's and the row's padding)
  MultBar
    id: lootBar
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 68
    width: 56

  MultBar
    id: xpBar
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 130
    width: 56

  Label
    id: goldKill
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 192
    width: 62
    text-align: right
    color: #e2a443
    phantom: true

  Label
    id: perKill
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 258
    width: 62
    text-align: right
    color: #cbc0e0
    phantom: true

  Label
    id: health
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 324
    width: 60
    text-align: right
    color: #cbc0e0
    phantom: true

  Label
    id: level
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 388
    width: 36
    text-align: center
    color: #e6e0f2
    phantom: true

  ElementCells
    id: elements
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 430

  Label
    id: name
    anchors.top: parent.top
    anchors.left: creature.right
    anchors.right: elements.left
    margin-top: 6
    margin-left: 8
    margin-right: 8
    height: 14
    color: #e6e0f2
    phantom: true

  Label
    id: info
    anchors.top: name.bottom
    anchors.left: name.left
    anchors.right: name.right
    margin-top: 5
    height: 14
    font: verdana-11px-monochrome
    color: #9789b3
    phantom: true

// a column title of the list: a click sorts by it, a second one reverses
HuntSortHead < UIButton
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  font: verdana-11px-monochrome
  color: #9789b3
  text-align: right
  change-cursor-image: true
  cursor: pointer
  $hover:
    color: #f3dcae

RateRowEven < RateRow
  background-color: #ffffff07

BoardRow < BrevesRow
  height: 33
  padding: 2

  UIWidget
    id: position
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 24 20
    text-align: center
    color: #9789b3
    phantom: true

  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    width: 110
    text-align: right
    color: #e6e0f2
    phantom: true

  Label
    id: name
    anchors.top: parent.top
    anchors.left: position.right
    anchors.right: value.left
    margin-left: 8
    margin-top: 1
    height: 14
    color: #e6e0f2
    phantom: true

  Label
    id: info
    anchors.top: name.bottom
    anchors.left: name.left
    anchors.right: name.right
    margin-top: 1
    height: 14
    font: verdana-11px-monochrome
    color: #9789b3
    phantom: true

BoardRowEven < BoardRow
  background-color: #ffffff07

HistoryLine < Label
  height: 16
  font: verdana-11px-monochrome
  color: #cbc0e0
  text-align: left
  text-offset: 4 0

// a range of the filters panel: its name, the low box, a dash, the high box
HuntRangeLabel < Label
  anchors.top: searchEdit.bottom
  margin-top: 10
  text-auto-resize: true
  font: verdana-11px-antialised
  color: #cbc0e0

HuntRangeEdit < MythosTextEdit
  anchors.top: searchEdit.bottom
  margin-top: 6
  size: 62 22
  placeholder-color: #75688f
  @onTextChange: modules.game_huntboard.onFilterChanged()

HuntRangeDash < Label
  anchors.top: searchEdit.bottom
  margin-top: 9
  width: 12
  text-align: center
  color: #9789b3
  text: -

HuntList < BrevesList
  focusable: false

// the section strip carries the title; the lua sets it through title
BoardColumn < BrevesSection
  padding: 22 4 4 4

  Label
    id: title
    visible: false

  HuntList
    id: list
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 324

  Label
    id: empty
    anchors.centerIn: list
    font: verdana-11px-monochrome
    color: #9789b3
    text-auto-resize: true
    !text: tr('Nobody yet - be the first!')

  Label
    id: mine
    anchors.top: list.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 16
    text-align: center
    color: #7fd35a

MythosWindow
  id: huntBoardWindow
  !text: tr('Hunt Board')
  size: 900 630
  @onEscape: modules.game_huntboard.hide()

  HuntTab
    id: ratesTab
    anchors.left: parent.left
    !text: tr('Hunts TP')
    @onClick: modules.game_huntboard.selectTab('rates')

  HuntTab
    id: boardTab
    anchors.left: prev.right
    margin-left: 4
    !text: tr('Leaderboard')
    @onClick: modules.game_huntboard.selectTab('board')

  // section name when Hunt Rates and Leaderboard open as separate windows
  Label
    id: sectionIntro
    anchors.left: parent.left
    anchors.verticalCenter: ratesTab.verticalCenter
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #e6e0f2
    visible: false

  // online reward progress (top right)
  UIWidget
    id: onlineBar
    anchors.right: parent.right
    anchors.verticalCenter: ratesTab.verticalCenter
    size: 150 16
    background-color: #0f0a19
    border-width: 1
    border-color: #3e2d5e

    UIWidget
      id: fill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin: 1
      width: 1
      background-color: #e2a443

    Label
      id: value
      anchors.fill: parent
      text-align: center
      font: verdana-11px-rounded
      color: #ffffff

  UIWidget
    id: onlineCoin
    anchors.right: onlineBar.left
    anchors.verticalCenter: onlineBar.verticalCenter
    margin-right: 5
    size: 12 12
    image-source: /images/store/icon-tibiacoin

  Label
    id: onlineTitle
    anchors.right: onlineCoin.left
    anchors.verticalCenter: onlineBar.verticalCenter
    margin-right: 5
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #cbc0e0
    !text: tr('Online reward')

  // why the last minute did not count (filled by updateOnline)
  Label
    id: onlineNote
    anchors.top: onlineBar.bottom
    anchors.right: onlineBar.right
    text-auto-resize: true
    font: verdana-9px-rounded
    color: #e2a443
    visible: false

  MythosSeparator
    id: topSep
    anchors.top: ratesTab.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  // ---------------------------------------------------------------- rates
  Panel
    id: ratesPanel
    anchors.top: topSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomSep.top
    margin-top: 6
    margin-bottom: 6

    // every filter of the list: the first line picks which monsters and
    // the order, the second takes ranges ("6k" and up, "1000" and down...)
    BrevesSection
      id: filterSection
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 84
      !text: tr('Filters')

      MythosTextEdit
        id: searchEdit
        anchors.top: parent.top
        anchors.left: parent.left
        size: 150 22
        !placeholder: tr('Search monster...')
        placeholder-color: #75688f
        @onTextChange: modules.game_huntboard.onFilterChanged()

      MythosComboBox
        id: showBox
        anchors.top: parent.top
        anchors.left: searchEdit.right
        margin-left: 6
        size: 134 22

      MythosComboBox
        id: rateBox
        anchors.top: parent.top
        anchors.left: showBox.right
        margin-left: 6
        size: 134 22

      MythosComboBox
        id: elementBox
        anchors.top: parent.top
        anchors.left: rateBox.right
        margin-left: 6
        size: 150 22

      MythosComboBox
        id: sortBox
        anchors.top: parent.top
        anchors.left: elementBox.right
        anchors.right: parent.right
        margin-left: 6
        height: 22

      HuntRangeLabel
        id: xpLabel
        anchors.left: parent.left
        !text: tr('XP/kill')

      HuntRangeEdit
        id: xpMin
        anchors.left: xpLabel.right
        margin-left: 5
        !placeholder: tr('min')

      HuntRangeDash
        id: xpDash
        anchors.left: xpMin.right

      HuntRangeEdit
        id: xpMax
        anchors.left: xpDash.right
        !placeholder: tr('max')

      HuntRangeLabel
        id: goldLabel
        anchors.left: xpMax.right
        margin-left: 16
        !text: tr('Gold/kill')

      HuntRangeEdit
        id: goldMin
        anchors.left: goldLabel.right
        margin-left: 5
        !placeholder: tr('min')

      HuntRangeDash
        id: goldDash
        anchors.left: goldMin.right

      HuntRangeEdit
        id: goldMax
        anchors.left: goldDash.right
        !placeholder: tr('max')

      HuntRangeLabel
        id: levelLabel
        anchors.left: goldMax.right
        margin-left: 16
        !text: tr('Hunt level')

      HuntRangeEdit
        id: levelMin
        anchors.left: levelLabel.right
        margin-left: 5
        width: 48
        !placeholder: tr('min')

      HuntRangeDash
        id: levelDash
        anchors.left: levelMin.right

      HuntRangeEdit
        id: levelMax
        anchors.left: levelDash.right
        width: 48
        !placeholder: tr('max')

      MythosButton
        id: myLevel
        anchors.top: xpMin.top
        anchors.left: levelMax.right
        margin-left: 6
        size: 78 22
        !text: tr('My level')

      MythosButton
        id: clearButton
        anchors.top: xpMin.top
        anchors.right: parent.right
        size: 104 22
        !text: tr('Clear filters')

    Label
      id: countdown
      anchors.top: filterSection.top
      anchors.right: filterSection.right
      margin-top: 3
      margin-right: 8
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #7fd35a

    BrevesHeader
      id: rateHeader
      anchors.top: filterSection.bottom
      anchors.left: parent.left
      anchors.right: rateScroll.left
      margin-top: 6

      // over the rows' columns: the row's margins + 4 (the list's and the
      // row's padding)
      HuntSortHead
        id: sortName
        anchors.left: parent.left
        margin-left: 88
        width: 150
        text-align: left

      ElementHead
        id: elementHead
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-right: 434

      HuntSortHead
        id: sortLevel
        anchors.right: parent.right
        margin-right: 392
        width: 36
        text-align: center

      HuntSortHead
        id: sortHp
        anchors.right: parent.right
        margin-right: 328
        width: 60

      HuntSortHead
        id: sortXpKill
        anchors.right: parent.right
        margin-right: 262
        width: 62

      HuntSortHead
        id: sortGoldKill
        anchors.right: parent.right
        margin-right: 196
        width: 62

      HuntSortHead
        id: sortXpRate
        anchors.right: parent.right
        margin-right: 134
        width: 56
        text-align: center

      HuntSortHead
        id: sortLootRate
        anchors.right: parent.right
        margin-right: 72
        width: 56
        text-align: center

      HuntSortHead
        id: sortTp
        anchors.right: parent.right
        margin-right: 10
        width: 54
        text-align: center

    HuntList
      id: rateList
      anchors.top: rateHeader.bottom
      anchors.left: parent.left
      anchors.right: rateScroll.left
      anchors.bottom: prevPage.top
      margin-bottom: 6
      vertical-scrollbar: rateScroll

    MythosScrollBar
      id: rateScroll
      anchors.top: filterSection.bottom
      margin-top: 26
      anchors.bottom: prevPage.top
      margin-bottom: 6
      anchors.right: parent.right
      step: 46
      pixel-scroll: true

    Label
      id: rateEmpty
      anchors.centerIn: rateList
      color: #9789b3
      text-auto-resize: true
      visible: false

    MythosButton
      id: prevPage
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      size: 78 22
      !text: tr('< Prev')
      @onClick: modules.game_huntboard.changePage(-1)

    MythosButton
      id: nextPage
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      size: 78 22
      !text: tr('Next >')
      @onClick: modules.game_huntboard.changePage(1)

    Label
      id: pageLabel
      anchors.left: prevPage.right
      anchors.right: nextPage.left
      anchors.verticalCenter: prevPage.verticalCenter
      text-align: center
      font: verdana-11px-monochrome
      color: #cbc0e0

  // ---------------------------------------------------------------- leaderboard
  Panel
    id: boardPanel
    anchors.fill: ratesPanel
    visible: false

    PeriodTab
      id: hourTab
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Hourly')
      @onClick: modules.game_huntboard.selectPeriod('hour')

    PeriodTab
      id: dayTab
      anchors.top: parent.top
      anchors.left: prev.right
      margin-left: 4
      !text: tr('Daily')
      @onClick: modules.game_huntboard.selectPeriod('day')

    PeriodTab
      id: monthTab
      anchors.top: parent.top
      anchors.left: prev.right
      margin-left: 4
      !text: tr('Monthly')
      @onClick: modules.game_huntboard.selectPeriod('month')

    Label
      id: ends
      anchors.top: parent.top
      anchors.right: parent.right
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #7fd35a

    UIWidget
      id: prizeCoin
      anchors.top: ends.bottom
      anchors.right: parent.right
      margin-top: 3
      size: 12 12
      image-source: /images/store/icon-tibiacoin

    Label
      id: prize
      anchors.right: prizeCoin.left
      anchors.verticalCenter: prizeCoin.verticalCenter
      margin-right: 4
      text-auto-resize: true
      color: #e6e0f2

    BoardColumn
      id: killsColumn
      anchors.top: hourTab.bottom
      anchors.left: parent.left
      margin-top: 14
      width: 390
      height: 374

    BoardColumn
      id: expColumn
      anchors.top: killsColumn.top
      anchors.right: parent.right
      width: 390
      height: 374

    Label
      id: historyTitle
      anchors.top: killsColumn.bottom
      anchors.left: parent.left
      margin-top: 8
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #cbc0e0
      !text: tr('Recent winners')

    HuntList
      id: history
      anchors.top: historyTitle.bottom
      anchors.left: parent.left
      anchors.right: historyScroll.left
      anchors.bottom: parent.bottom
      margin-top: 4
      vertical-scrollbar: historyScroll

    MythosScrollBar
      id: historyScroll
      anchors.top: historyTitle.bottom
      anchors.bottom: parent.bottom
      margin-top: 4
      anchors.right: parent.right
      step: 16
      pixel-scroll: true

  MythosSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Label
    id: footer
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    font: verdana-11px-antialised
    color: #9789b3
    !text: tr('Rates re-roll every 2 hours for every monster. Leaderboard winners are paid in Mythos Coins when the period ends.')

  MythosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 60 22
    !text: tr('Close')
    @onClick: modules.game_huntboard.hide()

HuntToast < MythosBox
  size: 440 78
  padding: 8
  phantom: false

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 44 44
    phantom: true

  Label
    id: title
    anchors.top: parent.top
    anchors.left: icon.right
    anchors.right: open.left
    margin-left: 8
    height: 16
    color: #e2a443
    phantom: true

  Label
    id: text
    anchors.top: title.bottom
    anchors.left: title.left
    anchors.right: open.left
    anchors.bottom: parent.bottom
    margin-top: 2
    text-wrap: true
    color: #d8d3e3
    phantom: true

  MythosButton
    id: open
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 56 22
    !text: tr('Open')

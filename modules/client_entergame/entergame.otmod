Module
  name: client_entergame
  description: Manages enter game and character list windows
  author: edubart
  website: https://github.com/edubart/otclient

  dependencies:
    - client_assets
    - game_features
    - game_things

  @onLoad: |
    dofile 'entergame'
    dofile 'characterlist'
    dofile 'createAccount'
    dofile 'crashreport'
    dofile 'patchnotes'
    dofile 'createcharacter'
    EnterGame.init()
    CharacterList.init()
    pcall(CrashReport.init)
    PatchNotes.init()

  @onUnload: |
    EnterGame.terminate()
    CharacterList.terminate()
    PatchNotes.terminate()
    CreateCharacter.terminate()

// one vocation to pick: its look in front, the name and the role below
CreateCharacterCard < UIButton
  size: 104 172
  image-source: /images/mythos/panel
  image-border: 4
  change-cursor-image: true
  cursor: pointer
  $hover !checked:
    image-source: /images/mythos/button_hover
  $checked:
    image-source: /images/mythos/panel_on

  // the 64px frame of the outfit, scaled up and centred
  UICreature
    id: outfit
    size: 96 96
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    creature-center: true
    phantom: true

  Label
    id: name
    anchors.top: outfit.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0
    text-align: center
    font: Verdana Bold-11px
    color: #e8dfce
    phantom: true
    $on:
      color: #ffffff

  Label
    id: role
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 3 4 0 4
    text-align: center
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #9789b3
    phantom: true

CreateCharacterCaption < Label
  font: Verdana Bold-11px
  color: #e8dfce
  text-auto-resize: true

MythosWindow
  id: createCharacterWindow
  !text: tr('Create Character')
  size: 596 500
  @onEnter: CreateCharacter.submit()
  @onEscape: CreateCharacter.hide()

  BrevesNote
    id: intro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    !text: tr('Pick a vocation, the sex and a name. The new character starts in the temple and appears on the list as soon as it is created.')

  Panel
    id: cards
    anchors.top: intro.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    height: 172
    layout:
      type: horizontalBox
      spacing: 8

  Label
    id: loading
    anchors.centerIn: cards
    !text: tr('Loading...')
    font: verdana-11px-antialised
    color: #b4afc3
    text-auto-resize: true

  BrevesNote
    id: vocationInfo
    anchors.top: cards.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    color: #d1ccd9

  MythosSeparator
    id: separator
    anchors.top: vocationInfo.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10

  CreateCharacterCaption
    id: sexCaption
    anchors.top: separator.bottom
    anchors.left: parent.left
    margin-top: 14
    width: 60
    !text: tr('Sex')

  MythosButton
    id: sexMale
    anchors.verticalCenter: sexCaption.verticalCenter
    anchors.left: parent.left
    margin-left: 70
    size: 100 22
    !text: tr('Male')
    @onClick: CreateCharacter.setSex(1)

  MythosButton
    id: sexFemale
    anchors.verticalCenter: sexCaption.verticalCenter
    anchors.left: sexMale.right
    margin-left: 6
    size: 100 22
    !text: tr('Female')
    @onClick: CreateCharacter.setSex(0)

  CreateCharacterCaption
    id: townCaption
    anchors.verticalCenter: sexCaption.verticalCenter
    anchors.left: sexFemale.right
    margin-left: 30
    !text: tr('Town')

  MythosComboBox
    id: townBox
    anchors.verticalCenter: sexCaption.verticalCenter
    anchors.left: townCaption.right
    margin-left: 10
    width: 140
    visible: false

  Label
    id: townName
    anchors.verticalCenter: sexCaption.verticalCenter
    anchors.left: townCaption.right
    margin-left: 10
    font: verdana-11px-antialised
    color: #d1ccd9
    text-auto-resize: true

  CreateCharacterCaption
    id: nameCaption
    anchors.top: sexCaption.bottom
    anchors.left: parent.left
    margin-top: 20
    width: 60
    !text: tr('Name')

  MythosTextEdit
    id: nameEdit
    anchors.verticalCenter: nameCaption.verticalCenter
    anchors.left: parent.left
    margin-left: 70
    width: 236
    max-length: 21
    !placeholder: tr("Your hero's name")
    @onTextChange: CreateCharacter.clearError()

  BrevesNote
    id: nameHint
    anchors.verticalCenter: nameCaption.verticalCenter
    anchors.left: nameEdit.right
    anchors.right: parent.right
    margin-left: 10

  Label
    id: errorLabel
    anchors.top: nameEdit.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 70
    font: verdana-11px-antialised
    color: #ff7b6b
    text-wrap: true
    text-auto-resize: true

  Label
    id: countLabel
    anchors.left: parent.left
    anchors.verticalCenter: createButton.verticalCenter
    font: verdana-11px-antialised
    color: #9789b3
    text-auto-resize: true

  MythosKitGoldButton28
    id: createButton
    !text: tr('Create')
    size: 130 28
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 10
    enabled: false
    @onClick: CreateCharacter.submit()

  MythosKitButton28
    id: cancelButton
    !text: tr('Cancel')
    size: 110 28
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: CreateCharacter.hide()

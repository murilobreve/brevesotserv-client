// Mythos login card (black, white logo, gold accents): brand + features on the left, sign-in form on the
// right. Every id the entergame.lua logic looks up is still a direct child of
// the window; the server/version fields stay hidden (single server client).

BrevesInput < UITextEdit
  font: verdana-11px-antialised
  color: #f2f2f2
  height: 30
  text-offset: 0 1
  padding: 8 10 6 10
  image-source: /images/brevesui/input
  image-border: 7
  selection-color: #0a0a0a
  selection-background-color: #f2f2f2
  change-cursor-image: false

  $focus:
    image-source: /images/brevesui/input_focus

BrevesPasswordInput < BrevesInput
  text-hidden: true
  padding-right: 32

  UICheckBox
    id: showPassword
    size: 19 20
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    image-rect: 0 0 19 20
    image-source: /images/ui/hide_eye
    !tooltip: tr('Show password')
    @onCheckChange: |
      self:getParent():setTextHidden(not self:isChecked())

    $!checked:
      image-clip: 0 0 19 20

    $checked:
      image-clip: 0 20 19 20

BrevesGoldButton < UIButton
  font: Verdana Bold-11px
  color: #0a0a0a
  height: 36
  image-source: /images/brevesui/button_gold
  image-border: 9

  $hover !disabled:
    image-source: /images/brevesui/button_gold_hover

  $pressed:
    image-source: /images/brevesui/button_gold_pressed
    text-offset: 0 1

  $disabled:
    image-source: /images/brevesui/button_gold_disabled
    color: #a6a6a6

BrevesLink < UIButton
  font: verdana-11px-antialised
  color: #ffffff
  text-auto-resize: true

  $hover:
    color: #bdbdbd

BrevesLabel < Label
  font: verdana-11px-antialised
  color: #a6a6a6

BrevesFeature < Panel
  height: 38
  anchors.left: parent.left
  anchors.right: parent.right

  UIWidget
    id: bullet
    size: 12 12
    image-source: /images/brevesui/bullet
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 2

  Label
    id: title
    font: Verdana Bold-11px
    color: #f2f2f2
    text-auto-resize: true
    anchors.left: bullet.right
    anchors.top: parent.top
    margin-left: 10

  Label
    id: desc
    font: verdana-11px-antialised
    color: #a6a6a6
    anchors.left: title.left
    anchors.right: parent.right
    anchors.top: title.bottom
    margin-top: 3
    text-auto-resize: true

EnterGameWindow < UIWindow
  size: 660 312
  anchors.centerIn: parent
  image-source: /images/brevesui/panel
  image-border: 12
  color: #00000000
  padding: 0

ServerListButton < UIButton
  size: 17 17
  image-source: /images/topbuttons/minimap

EnterGameWindow
  id: enterGame
  &authenticatorEnabled: false
  &authenticatorHeight: 44
  &stayLoggedBoxEnabled: false
  &stayLoggedBoxHeight: 24
  @onEnter: EnterGame.doLogin()

  // ---------------------------------------------------------------- brand
  Panel
    id: brandPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 300
    padding: 26 24 22 26
    phantom: true

    UIWidget
      id: logo
      size: 271 64
      image-source: /images/brevesui/logo
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: -8
      phantom: true

    BrevesFeature
      id: featRarity
      anchors.top: logo.bottom
      margin-top: 24
      @onSetup: |
        self.title:setText(tr('Rarity drops'))
        self.desc:setText(tr('Five grades, up to Mythicus'))

    BrevesFeature
      id: featHunt
      anchors.top: prev.bottom
      margin-top: 8
      @onSetup: |
        self.title:setText(tr('Hunt Board'))
        self.desc:setText(tr('Rates up to x10, new roll every 2h'))

    BrevesFeature
      id: featCoins
      anchors.top: prev.bottom
      margin-top: 8
      @onSetup: |
        self.title:setText(tr('Mythos Coins'))
        self.desc:setText(tr('Leaderboard prizes, 1 per hour online'))

    BrevesFeature
      id: featMarket
      anchors.top: prev.bottom
      margin-top: 8
      @onSetup: |
        self.title:setText(tr('Rarity Market'))
        self.desc:setText(tr('Trade rare gear with other players'))

  UIWidget
    id: brandSeparator
    width: 1
    background-color: #2a2a2a
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: brandPanel.right
    margin-top: 22
    margin-bottom: 22
    phantom: true

  // ----------------------------------------------------------------- form
  Label
    id: formTitle
    !text: tr('Welcome back')
    font: Verdana Bold-13px
    color: #ffffff
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: brandSeparator.right
    margin-top: 28
    margin-left: 30

  BrevesLabel
    id: formSubtitle
    !text: tr('Sign in to play')
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 4

  BrevesLabel
    id: emailLabel
    !text: tr('Account name or email')
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 18

  BrevesInput
    id: accountNameTextEdit
    anchors.top: prev.bottom
    anchors.left: prev.left
    anchors.right: parent.right
    margin-top: 5
    margin-right: 30

  BrevesLabel
    id: passwordLabel
    !text: tr('Password')
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 12

  BrevesPasswordInput
    id: accountPasswordTextEdit
    anchors.top: prev.bottom
    anchors.left: prev.left
    anchors.right: accountNameTextEdit.right
    margin-top: 5

  QtCheckBox
    id: rememberEmailBox
    !text: tr('Remember me')
    !tooltip: tr('Keep your account and password saved on this computer')
    font: verdana-11px-antialised
    color: #d9d9d9
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 12
    @onCheckChange: |
      self:getParent():getChildById('autoLoginBox'):setEnabled(self:isChecked())

  BrevesLink
    id: Forgot_password_email
    !text: tr('Forgot password?')
    anchors.right: accountNameTextEdit.right
    anchors.verticalCenter: rememberEmailBox.verticalCenter
    @onClick: g_platform.openUrl(Services.website .. '/index.php/account/lost')
    @onSetup: |
      self:setVisible(Services ~= nil and Services.website ~= nil)

  BrevesGoldButton
    id: enterButton
    !text: tr('PLAY')
    anchors.top: rememberEmailBox.bottom
    anchors.left: accountNameTextEdit.left
    anchors.right: accountNameTextEdit.right
    margin-top: 16
    @onClick: EnterGame.doLogin()

  BrevesLabel
    id: newHereLabel
    !text: tr('New here?')
    text-auto-resize: true
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 14

  BrevesLink
    id: btnCreateNewAccount
    !text: tr('Create a free account')
    anchors.left: prev.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 5
    @onClick: EnterGame.createAccount()
    @onSetup: |
      self:setVisible(Services ~= nil and (Services.createAccount ~= nil or Services.website ~= nil))

  Label
    id: serverInfoLabel
    font: verdana-11px-antialised
    color: #4fd66b
    text-auto-resize: true
    anchors.top: newHereLabel.bottom
    anchors.left: newHereLabel.left
    margin-top: 6

  // ------------------------------------------ hidden (single-server client)
  UIWidget
    id: rememberEmailTip
    size: 1 1
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false

  QtCheckBox
    id: autoLoginBox
    enabled: false
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false

  QtCheckBox
    id: stayLoggedBox
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false

  QtCheckBox
    id: httpLoginBox
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false

  MenuLabel
    id: serverLabel
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false

  ServerListButton
    id: serverListButton
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false
    @onClick: EnterGame.showServerList()

  TextEdit
    id: serverHostTextEdit
    width: 100
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false

  MenuLabel
    id: clientLabel
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false

  ComboBox
    id: clientComboBox
    width: 90
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false
    menu-scroll: true
    menu-height: 125
    menu-scroll-step: 25

  MenuLabel
    id: portLabel
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false

  TextEdit
    id: serverPortTextEdit
    text: 7171
    width: 60
    anchors.top: parent.top
    anchors.left: parent.left
    visible: false
